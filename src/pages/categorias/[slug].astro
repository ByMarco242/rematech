---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getDb, type Product, type Category } from '../../lib/db';
import { getWishlistedIds } from '../../lib/wishlist';

const db = await getDb();
const wishlistedIds = Astro.locals.user ? await getWishlistedIds(Astro.locals.user.id) : new Set<number>();
const { slug } = Astro.params;

const catRes = await db.execute({
  sql: 'SELECT * FROM categories WHERE slug = ?',
  args: [slug ?? ''],
});
const category = catRes.rows[0] as unknown as Category | undefined;
if (!category) return Astro.redirect('/productos');

const productsRes = await db.execute({
  sql: `SELECT p.*, c.name AS category_name, c.slug AS category_slug
        FROM products p LEFT JOIN categories c ON c.id = p.category_id
        WHERE p.category_id = ? ORDER BY p.created_at DESC`,
  args: [category.id],
});
const products = productsRes.rows as unknown as Product[];
---

<BaseLayout title={`${category.name} — NoteStore`} description={category.description}>
  <section class="border-b border-line-strong">
    <div class="mx-auto flex max-w-7xl items-center gap-6 px-4 py-10 sm:px-6">
      <div class="min-w-0 flex-1">
        <nav class="flex items-center gap-2 text-sm text-fg-muted">
          <a href="/" class="hover:text-fg">Inicio</a>
          <span>/</span>
          <a href="/#categorias" class="hover:text-fg">Categorías</a>
        </nav>
        <h1 class="font-display uppercase mt-3 text-4xl font-extrabold">{category.name}</h1>
        <p class="mt-2 max-w-xl text-lg text-fg-muted">{category.description}</p>
      </div>
      <img src={category.image_url} alt="" class="hidden aspect-[4/3] w-56 border border-line-strong object-cover sm:block" />
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
    {products.length === 0 ? (
      <div class="border border-dashed border-line-strong p-16 text-center">
        <p class="text-lg font-semibold text-fg-muted">Todavía no hay productos en esta categoría</p>
        <a href="/productos" class="btn btn-primary mt-5 inline-block">
          Ver todo el catálogo
        </a>
      </div>
    ) : (
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {products.map((p) => (
          <ProductCard product={p} wishlisted={wishlistedIds.has(p.id)} />
        ))}
      </div>
    )}
  </div>
</BaseLayout>
