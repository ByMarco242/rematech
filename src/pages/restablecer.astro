---
import BaseLayout from '../layouts/BaseLayout.astro';
import { verifyPasswordReset, resetPassword, validatePassword } from '../lib/auth';

if (Astro.locals.user) return Astro.redirect('/');

const token = Astro.url.searchParams.get('token') ?? '';
let error = '';
let done = false;

const userId = token ? await verifyPasswordReset(token) : null;

if (Astro.request.method === 'POST' && userId !== null) {
  const form = await Astro.request.formData();
  const password = String(form.get('password') ?? '').slice(0, 100);
  const confirm = String(form.get('confirm') ?? '').slice(0, 100);

  const pwError = validatePassword(password);
  if (pwError) {
    error = pwError;
  } else if (password !== confirm) {
    error = 'Las contraseñas no coinciden.';
  } else {
    await resetPassword(userId, password);
    done = true;
  }
}
---

<BaseLayout title="Nueva contraseña — NoteStore">
  <div class="mx-auto flex max-w-md flex-col px-4 py-16 sm:px-6">
    <div class="border border-line bg-surface p-8 sm:p-10">
      <h1 class="font-display uppercase text-2xl font-extrabold">Nueva contraseña</h1>

      {done ? (
        <div class="mt-5 border border-ok/40 px-4 py-4 text-sm text-ok">
          <p class="font-semibold">¡Contraseña actualizada! ✓</p>
          <p class="mt-1">Ya podés ingresar con tu contraseña nueva.</p>
          <a href="/login" class="btn btn-primary mt-3 inline-block">
            Ir a ingresar
          </a>
        </div>
      ) : userId === null ? (
        <div class="mt-5 border border-danger/40 px-4 py-4 text-sm text-danger">
          <p class="font-semibold">Enlace inválido o vencido</p>
          <p class="mt-1">
            Los enlaces valen 1 hora. Pedí uno nuevo desde
            <a href="/recuperar" class="font-semibold underline">recuperar contraseña</a>.
          </p>
        </div>
      ) : (
        <>
          <p class="mt-2 text-sm text-fg-muted">
            Elegí tu nueva contraseña: mínimo 8 caracteres, con mayúscula, minúscula y número.
          </p>
          {error && (
            <p class="mt-5 border border-danger/40 px-4 py-3 text-sm font-medium text-danger">{error}</p>
          )}
          <form method="POST" class="mt-6 space-y-4">
            <div>
              <label for="password" class="mb-1.5 block text-sm font-medium text-fg-muted">Nueva contraseña</label>
              <input
                id="password"
                type="password"
                name="password"
                required
                minlength="8"
                maxlength="100"
                autocomplete="new-password"
                class="field"
              />
            </div>
            <div>
              <label for="confirm" class="mb-1.5 block text-sm font-medium text-fg-muted">Repetir contraseña</label>
              <input
                id="confirm"
                type="password"
                name="confirm"
                required
                minlength="8"
                maxlength="100"
                autocomplete="new-password"
                class="field"
              />
            </div>
            <button
              type="submit"
              class="btn btn-primary w-full"
            >
              Guardar contraseña
            </button>
          </form>
        </>
      )}
    </div>
  </div>
</BaseLayout>
