---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDb, type ShippingZone } from '../lib/db';
const user = Astro.locals.user;
const db = await getDb();
const zonesRes = await db.execute('SELECT * FROM shipping_zones WHERE active = 1 ORDER BY name');
const zones = zonesRes.rows as unknown as ShippingZone[];
---

<BaseLayout title="Carrito — NoteStore">
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
    <h1 class="font-display border-b border-line pb-5 text-4xl font-extrabold uppercase sm:text-5xl">Carrito</h1>

    <div id="cart-empty" class="mt-8 hidden border border-dashed border-line-strong p-12 text-center">
      <p class="font-semibold">Tu carrito está vacío</p>
      <p class="mt-1 text-sm text-fg-muted">Agregá equipos desde el catálogo y volvé acá para finalizar el pedido.</p>
      <a href="/productos" class="btn btn-primary mt-5">Ver notebooks</a>
    </div>

    <div id="cart-content" class="mt-8 hidden grid-cols-1 gap-8 lg:grid-cols-12">
      <section class="lg:col-span-8" aria-label="Productos en el carrito">
        <ul id="cart-items" class="divide-y divide-line border-b border-line"></ul>
        <a href="/productos" class="mt-4 inline-block text-sm text-fg-muted hover:text-fg">← Seguir comprando</a>
      </section>

      <aside class="lg:col-span-4" aria-label="Resumen del pedido">
        <div class="border border-line bg-surface p-5 lg:sticky lg:top-20">
          <h2 class="eyebrow text-fg-subtle">Resumen</h2>

          <div class="mt-4">
            <label for="coupon-input" class="text-sm text-fg-muted">Cupón de descuento</label>
            <div class="mt-1.5 flex gap-2">
              <input id="coupon-input" type="text" placeholder="CÓDIGO" class="field font-mono uppercase" autocomplete="off" />
              <button id="coupon-apply" type="button" class="btn btn-secondary">Aplicar</button>
            </div>
            <p id="coupon-msg" class="mt-2 text-sm" role="status"></p>
          </div>

          {zones.length > 0 && (
            <div class="mt-4">
              <label for="zone-select" class="text-sm text-fg-muted">Envío</label>
              <select id="zone-select" class="field mt-1.5">
                <option value="">Retiro en local (sin costo)</option>
                {zones.map((z) => (
                  <option value={z.id} data-cost={z.cost}>{z.name} — {new Intl.NumberFormat('es-PY', { style: 'currency', currency: 'PYG', maximumFractionDigits: 0 }).format(z.cost)}</option>
                ))}
              </select>
            </div>
          )}

          <dl class="mt-5 space-y-1.5 border-t border-line pt-4 text-sm">
            <div class="flex items-center justify-between">
              <dt class="text-fg-muted">Subtotal</dt>
              <dd id="cart-subtotal" class="font-mono"></dd>
            </div>
            <div id="discount-row" class="hidden flex items-center justify-between text-ok">
              <dt>Descuento</dt>
              <dd id="cart-discount" class="font-mono"></dd>
            </div>
            <div id="shipping-row" class="hidden flex items-center justify-between">
              <dt class="text-fg-muted">Envío</dt>
              <dd id="cart-shipping" class="font-mono"></dd>
            </div>
          </dl>
          <div class="mt-3 flex items-baseline justify-between border-t border-line pt-3">
            <span class="text-sm text-fg-muted">Total</span>
            <span id="cart-total" class="text-2xl font-semibold tracking-tight"></span>
          </div>
          <button id="checkout-btn" type="button" class="btn btn-primary mt-5 w-full py-3 text-base">
            Finalizar pedido por WhatsApp
          </button>
          <p class="mt-3 text-xs leading-relaxed text-fg-subtle">
            Tu pedido queda registrado y se abre WhatsApp con el detalle para coordinar el pago y la entrega.
          </p>
        </div>
      </aside>
    </div>

    <div id="order-success" class="mt-8 hidden border border-line bg-surface p-10 text-center" role="status">
      <span class="mx-auto block size-3 bg-ok" aria-hidden="true"></span>
      <p id="order-success-title" class="font-display mt-4 text-2xl font-extrabold uppercase">Pedido registrado</p>
      <p class="mt-2 text-sm text-fg-muted">
        Si WhatsApp no se abrió automáticamente, usá el botón para enviarnos el pedido.
      </p>
      <a id="order-wa-link" href="#" target="_blank" rel="noopener" class="btn btn-primary mt-5">Abrir WhatsApp</a>
    </div>
  </div>

  <template id="cart-item-template">
    <li class="grid grid-cols-[4.5rem_1fr_auto] items-center gap-x-4 gap-y-3 py-4 sm:grid-cols-[5.5rem_1fr_auto_7.5rem_auto]">
      <img data-el="image" class="aspect-square w-full border border-line bg-surface object-cover" alt="" />
      <div class="min-w-0">
        <a data-el="name" class="block truncate font-semibold hover:text-accent"></a>
        <p data-el="variant" class="text-xs text-fg-subtle"></p>
        <p data-el="price" class="mt-0.5 font-mono text-xs text-fg-muted"></p>
      </div>
      <div class="col-start-2 flex w-fit items-center border border-line sm:col-start-auto" role="group" aria-label="Cantidad">
        <button data-el="minus" type="button" class="size-8 cursor-pointer text-fg-muted hover:bg-surface-2 hover:text-fg" aria-label="Restar uno">−</button>
        <span data-el="qty" class="w-8 text-center font-mono text-sm" aria-live="polite"></span>
        <button data-el="plus" type="button" class="size-8 cursor-pointer text-fg-muted hover:bg-surface-2 hover:text-fg" aria-label="Sumar uno">+</button>
      </div>
      <p data-el="subtotal" class="col-start-3 row-start-1 text-right font-semibold sm:col-start-auto sm:row-start-auto"></p>
      <button data-el="remove" type="button" class="col-start-3 row-start-2 cursor-pointer justify-self-end p-2 text-fg-subtle transition-colors hover:text-danger sm:col-start-auto sm:row-start-auto" aria-label="Quitar del carrito">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
      </button>
    </li>
  </template>

  <script is:inline define:vars={{ loggedIn: Boolean(user) }}>
    const fmt = new Intl.NumberFormat('es-PY', {
      style: 'currency',
      currency: 'PYG',
      maximumFractionDigits: 0,
    });

    let appliedCoupon = null; // { code, discount }

    function subtotalOf(cart) {
      return cart.reduce((acc, i) => acc + i.price * i.qty, 0);
    }

    function shippingCost() {
      const sel = document.getElementById('zone-select');
      if (!sel || !sel.value) return 0;
      const opt = sel.options[sel.selectedIndex];
      return Number(opt.dataset.cost || 0);
    }

    function render() {
      const cart = window.NoteStoreCart.get();
      const empty = document.getElementById('cart-empty');
      const content = document.getElementById('cart-content');
      const list = document.getElementById('cart-items');
      const tpl = document.getElementById('cart-item-template');

      empty.classList.toggle('hidden', cart.length > 0);
      content.classList.toggle('hidden', cart.length === 0);
      content.classList.toggle('grid', cart.length > 0);
      list.innerHTML = '';

      for (const item of cart) {
        const node = tpl.content.cloneNode(true);
        const el = (name) => node.querySelector(`[data-el="${name}"]`);
        el('image').src = item.image;
        el('image').alt = item.name;
        el('name').textContent = item.name;
        el('name').href = `/productos/${item.slug}`;
        el('variant').textContent = item.variantLabel || '';
        el('price').textContent = fmt.format(item.price) + ' c/u';
        el('qty').textContent = item.qty;
        el('subtotal').textContent = fmt.format(item.price * item.qty);
        el('minus').addEventListener('click', () => {
          if (item.qty <= 1) window.NoteStoreCart.remove(item.id, item.variantId);
          else window.NoteStoreCart.setQty(item.id, item.qty - 1, item.variantId);
          render();
        });
        el('plus').addEventListener('click', () => {
          window.NoteStoreCart.setQty(item.id, item.qty + 1, item.variantId);
          render();
        });
        el('remove').addEventListener('click', () => {
          window.NoteStoreCart.remove(item.id, item.variantId);
          render();
        });
        list.appendChild(node);
      }

      const subtotal = subtotalOf(cart);
      const discount = appliedCoupon ? appliedCoupon.discount : 0;
      const shipping = shippingCost();
      const total = Math.max(subtotal - discount, 0) + shipping;

      document.getElementById('cart-subtotal').textContent = fmt.format(subtotal);
      const discountRow = document.getElementById('discount-row');
      if (discountRow) {
        discountRow.classList.toggle('hidden', discount <= 0);
        document.getElementById('cart-discount').textContent = `-${fmt.format(discount)}`;
      }
      const shippingRow = document.getElementById('shipping-row');
      if (shippingRow) {
        shippingRow.classList.toggle('hidden', shipping <= 0);
        document.getElementById('cart-shipping').textContent = fmt.format(shipping);
      }
      document.getElementById('cart-total').textContent = fmt.format(total);
    }

    const couponBtn = document.getElementById('coupon-apply');
    if (couponBtn) {
      couponBtn.addEventListener('click', async () => {
        const input = document.getElementById('coupon-input');
        const msg = document.getElementById('coupon-msg');
        const code = input.value.trim();
        if (!code) return;
        const subtotal = subtotalOf(window.NoteStoreCart.get());
        try {
          const res = await fetch(`/api/cupon?code=${encodeURIComponent(code)}&subtotal=${subtotal}`);
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Cupón inválido.');
          appliedCoupon = { code: data.code, discount: data.discount };
          msg.textContent = `Cupón «${data.code}» aplicado`;
          msg.className = 'mt-2 text-sm text-ok';
        } catch (err) {
          appliedCoupon = null;
          msg.textContent = err.message;
          msg.className = 'mt-2 text-sm text-danger';
        }
        render();
      });
    }

    const zoneSelect = document.getElementById('zone-select');
    if (zoneSelect) zoneSelect.addEventListener('change', render);

    const checkoutBtn = document.getElementById('checkout-btn');
    checkoutBtn.addEventListener('click', async () => {
      if (!loggedIn) {
        window.location.href = '/login?next=/carrito';
        return;
      }
      const items = window.NoteStoreCart.get().map((i) => ({ id: i.id, qty: i.qty, variantId: i.variantId }));
      if (items.length === 0) return;

      checkoutBtn.disabled = true;
      checkoutBtn.textContent = 'Registrando pedido...';
      try {
        const res = await fetch('/api/pedidos', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            items,
            couponCode: appliedCoupon ? appliedCoupon.code : undefined,
            shippingZoneId: zoneSelect && zoneSelect.value ? Number(zoneSelect.value) : undefined,
          }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'No se pudo registrar el pedido.');

        window.NoteStoreCart.save([]);
        render();
        document.getElementById('cart-empty').classList.add('hidden');
        const success = document.getElementById('order-success');
        success.classList.remove('hidden');
        document.getElementById('order-success-title').textContent =
          `Pedido #${data.orderId} registrado`;
        document.getElementById('order-wa-link').href = data.waUrl;
        window.open(data.waUrl, '_blank');
      } catch (err) {
        window.showToast(err.message);
        checkoutBtn.disabled = false;
        checkoutBtn.textContent = 'Finalizar pedido por WhatsApp';
      }
    });

    render();
  </script>
</BaseLayout>
