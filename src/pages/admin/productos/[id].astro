---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ProductForm from '../../../components/ProductForm.astro';
import { getDb, type Category, type Product } from '../../../lib/db';
import {
  parseProductForm,
  uniqueProductSlug,
  saveProductImages,
  saveProductVariants,
  parseVariantsForm,
  getProductImages,
  getProductVariants,
} from '../../../lib/products';
import { logAudit } from '../../../lib/audit';
import { formatPrice } from '../../../lib/util';

const db = await getDb();
const id = Number(Astro.params.id);
if (!Number.isInteger(id)) return Astro.redirect('/admin/productos');

let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const parsed = parseProductForm(form);
  if (parsed.error || !parsed.data) {
    error = parsed.error ?? 'Datos inválidos.';
  } else {
    const d = parsed.data;
    const slug = await uniqueProductSlug(d.name, id);
    const beforeRes = await db.execute({ sql: 'SELECT price, cost, stock FROM products WHERE id = ?', args: [id] });
    const before = beforeRes.rows[0];
    await db.execute({
      sql: `UPDATE products SET
              name = ?, slug = ?, brand = ?, description = ?, price = ?, old_price = ?,
              cost = ?, image_url = ?, category_id = ?, cpu = ?, ram = ?, storage = ?,
              screen = ?, gpu = ?, stock = ?, min_stock = ?, featured = ?
            WHERE id = ?`,
      args: [
        d.name, slug, d.brand, d.description, d.price, d.old_price, d.cost, d.image_url,
        d.category_id, d.cpu, d.ram, d.storage, d.screen, d.gpu, d.stock, d.min_stock, d.featured, id,
      ],
    });
    if (before) {
      const changes: string[] = [];
      if (Number(before.price) !== d.price) changes.push(`precio ${formatPrice(Number(before.price))} → ${formatPrice(d.price)}`);
      if (Number(before.cost) !== d.cost) changes.push(`costo ${formatPrice(Number(before.cost))} → ${formatPrice(d.cost)}`);
      if (Number(before.stock) !== d.stock) changes.push(`stock ${before.stock} → ${d.stock}`);
      await logAudit(Astro.locals.user!.name, 'Editó producto', 'producto', id, [d.name, ...changes].join(' · '));
    }
    const extraImages = String(form.get('extra_images') ?? '').split('\n');
    await saveProductImages(id, extraImages);
    await saveProductVariants(id, parseVariantsForm(form));
    return Astro.redirect('/admin/productos');
  }
}

const res = await db.execute({ sql: 'SELECT * FROM products WHERE id = ?', args: [id] });
const product = res.rows[0] as unknown as Product | undefined;
if (!product) return Astro.redirect('/admin/productos');

const categoriesRes = await db.execute('SELECT * FROM categories ORDER BY name');
const categories = categoriesRes.rows as unknown as Category[];
const images = await getProductImages(id);
const variants = await getProductVariants(id);
---

<AdminLayout title={`Editar ${product.name} — NoteStore admin`}>
  <nav class="text-sm text-neutral-500">
    <a href="/admin/productos" class="hover:text-neutral-900">← Volver a productos</a>
  </nav>
  <div class="mt-3 mb-8 flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-bold tracking-tight">Editar producto</h1>
    <a href={`/productos/${product.slug}`} target="_blank" class="text-sm font-semibold text-neutral-900 hover:underline">
      Ver en la tienda ↗
    </a>
  </div>
  <ProductForm product={product} categories={categories} error={error} submitLabel="Guardar cambios" images={images} variants={variants} />
</AdminLayout>
