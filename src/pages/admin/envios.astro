---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb, type ShippingZone } from '../../lib/db';
import { formatPrice } from '../../lib/util';

const db = await getDb();
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('_action');

  if (action === 'delete') {
    const id = Number(form.get('id'));
    if (Number.isInteger(id)) {
      await db.execute({ sql: 'DELETE FROM shipping_zones WHERE id = ?', args: [id] });
    }
    return Astro.redirect('/admin/envios');
  }

  if (action === 'toggle') {
    const id = Number(form.get('id'));
    if (Number.isInteger(id)) {
      await db.execute({ sql: 'UPDATE shipping_zones SET active = 1 - active WHERE id = ?', args: [id] });
    }
    return Astro.redirect('/admin/envios');
  }

  if (action === 'create') {
    const name = String(form.get('name') ?? '').trim();
    const cost = Number(form.get('cost'));
    if (!name) {
      error = 'El nombre de la zona es obligatorio.';
    } else if (!Number.isFinite(cost) || cost < 0) {
      error = 'El costo no es válido.';
    } else {
      await db.execute({
        sql: 'INSERT INTO shipping_zones (name, cost) VALUES (?, ?)',
        args: [name.slice(0, 80), cost],
      });
      return Astro.redirect('/admin/envios');
    }
  }
}

const res = await db.execute('SELECT * FROM shipping_zones ORDER BY name');
const zones = res.rows as unknown as ShippingZone[];

const input =
  'w-full rounded-xl border border-neutral-200 bg-white px-4 py-2.5 text-sm outline-none focus:border-neutral-500 focus:ring-2 focus:ring-neutral-200';
---

<AdminLayout title="Envíos — NoteStore admin">
  <h1 class="text-2xl font-bold tracking-tight">Zonas de envío</h1>
  <p class="mt-1 text-sm text-neutral-500">Tarifas fijas que el cliente elige al finalizar el pedido en el carrito.</p>

  <div class="mt-8 grid gap-6 lg:grid-cols-3">
    <div class="lg:col-span-2">
      <div class="overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-sm">
        {zones.length === 0 ? (
          <p class="p-10 text-center text-neutral-500">Todavía no hay zonas de envío.</p>
        ) : (
          <table class="w-full text-sm">
            <thead class="border-b border-neutral-200 bg-neutral-50 text-left text-xs text-neutral-500 uppercase">
              <tr>
                <th class="px-5 py-3 font-medium">Zona</th>
                <th class="px-5 py-3 font-medium">Costo</th>
                <th class="px-5 py-3 font-medium">Estado</th>
                <th class="px-5 py-3 text-right font-medium">Acciones</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-neutral-100">
              {zones.map((z) => (
                <tr class="hover:bg-neutral-50">
                  <td class="px-5 py-3 font-medium">{z.name}</td>
                  <td class="px-5 py-3 text-neutral-600">{formatPrice(z.cost)}</td>
                  <td class="px-5 py-3">
                    <span class:list={['rounded-full px-2.5 py-1 text-xs font-semibold', z.active ? 'bg-emerald-50 text-emerald-700' : 'bg-neutral-100 text-neutral-500']}>
                      {z.active ? 'Activa' : 'Inactiva'}
                    </span>
                  </td>
                  <td class="px-5 py-3">
                    <div class="flex items-center justify-end gap-1">
                      <form method="POST">
                        <input type="hidden" name="_action" value="toggle" />
                        <input type="hidden" name="id" value={z.id} />
                        <button type="submit" class="cursor-pointer rounded-lg px-3 py-1.5 text-xs font-semibold text-neutral-500 hover:bg-neutral-100">
                          {z.active ? 'Desactivar' : 'Activar'}
                        </button>
                      </form>
                      <form method="POST" onsubmit={`return confirm('¿Eliminar la zona «${z.name.replace(/'/g, '')}»?')`}>
                        <input type="hidden" name="_action" value="delete" />
                        <input type="hidden" name="id" value={z.id} />
                        <button type="submit" class="cursor-pointer rounded-lg px-3 py-1.5 text-xs font-semibold text-rose-600 hover:bg-rose-50">
                          Eliminar
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </div>
    </div>

    <div>
      <div class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm">
        <h2 class="font-bold">Nueva zona</h2>
        {error && <p class="mt-4 rounded-xl bg-rose-50 px-4 py-3 text-sm font-medium text-rose-600">{error}</p>}
        <form method="POST" class="mt-4 space-y-4">
          <input type="hidden" name="_action" value="create" />
          <div>
            <label for="z-name" class="mb-1.5 block text-sm font-medium text-neutral-700">Nombre *</label>
            <input id="z-name" name="name" required class={input} placeholder="Ej: Capital" />
          </div>
          <div>
            <label for="z-cost" class="mb-1.5 block text-sm font-medium text-neutral-700">Costo *</label>
            <input id="z-cost" name="cost" type="number" step="0.01" min="0" required class={input} />
          </div>
          <button type="submit" class="w-full cursor-pointer rounded-xl bg-neutral-900 py-3 font-semibold text-white transition-colors hover:bg-neutral-700">
            Crear zona
          </button>
        </form>
      </div>
    </div>
  </div>
</AdminLayout>
