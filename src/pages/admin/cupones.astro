---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { listCoupons, createCoupon, deleteCoupon, toggleCoupon, deactivateStaleCoupons, couponStatus } from '../../lib/coupons';
import { logAudit } from '../../lib/audit';

const me = Astro.locals.user!;

// Los cupones vencidos o agotados se desactivan solos al entrar
const autoOff = await deactivateStaleCoupons();
if (autoOff.length > 0) await logAudit('Sistema', 'Desactivó cupones vencidos/agotados', 'cupon', null, autoOff.join(', '));
import { formatPrice } from '../../lib/util';

let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('_action');

  if (action === 'delete') {
    const id = Number(form.get('id'));
    if (Number.isInteger(id)) {
      await deleteCoupon(id);
      await logAudit(me.name, 'Eliminó cupón', 'cupon', id);
    }
    return Astro.redirect('/admin/cupones');
  }

  if (action === 'toggle') {
    const id = Number(form.get('id'));
    if (Number.isInteger(id)) {
      await toggleCoupon(id);
      await logAudit(me.name, 'Activó/pausó cupón', 'cupon', id);
    }
    return Astro.redirect('/admin/cupones');
  }

  if (action === 'create') {
    const type = form.get('type') === 'fixed' ? 'fixed' : 'percent';
    const value = Number(form.get('value'));
    const minTotal = Number(form.get('min_total') ?? 0) || 0;
    const maxUsesRaw = String(form.get('max_uses') ?? '').trim();
    const expiresRaw = String(form.get('expires_at') ?? '').trim();
    const result = await createCoupon({
      code: String(form.get('code') ?? ''),
      type,
      value,
      minTotal,
      maxUses: maxUsesRaw ? Number(maxUsesRaw) : null,
      expiresAt: expiresRaw || null,
    });
    if (result.error) {
      error = result.error;
    } else {
      await logAudit(me.name, 'Creó cupón', 'cupon', null, String(form.get('code') ?? '').toUpperCase());
      return Astro.redirect('/admin/cupones');
    }
  }
}

const coupons = await listCoupons();
const statusStyle: Record<string, string> = {
  activo: 'bg-emerald-50 text-emerald-700',
  pausado: 'bg-neutral-100 text-neutral-500',
  vencido: 'bg-amber-50 text-amber-700',
  agotado: 'bg-amber-50 text-amber-700',
};

const input =
  'w-full rounded-xl border border-neutral-200 bg-white px-4 py-2.5 text-sm outline-none focus:border-neutral-500 focus:ring-2 focus:ring-neutral-200';
---

<AdminLayout title="Cupones — NoteStore admin">
  <h1 class="text-2xl font-bold tracking-tight">Cupones</h1>
  <p class="mt-1 text-sm text-neutral-500">Descuentos por porcentaje o monto fijo, aplicables en el carrito.</p>

  <div class="mt-8 grid gap-6 lg:grid-cols-3">
    <div class="min-w-0 lg:col-span-2">
      <div class="overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-sm">
        {coupons.length === 0 ? (
          <p class="p-10 text-center text-neutral-500">Todavía no hay cupones.</p>
        ) : (
          <table class="w-full text-sm">
            <thead class="border-b border-neutral-200 bg-neutral-50 text-left text-xs text-neutral-500 uppercase">
              <tr>
                <th class="px-5 py-3 font-medium">Código</th>
                <th class="px-5 py-3 font-medium">Descuento</th>
                <th class="px-5 py-3 font-medium">Usos</th>
                <th class="px-5 py-3 font-medium">Estado</th>
                <th class="px-5 py-3 text-right font-medium">Acciones</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-neutral-100">
              {coupons.map((c) => (
                <tr class="hover:bg-neutral-50">
                  <td class="px-5 py-3 font-mono font-semibold">{c.code}</td>
                  <td class="px-5 py-3 text-neutral-600">
                    {c.type === 'percent' ? `${c.value}%` : formatPrice(c.value)}
                    {c.min_total > 0 && <span class="text-xs text-neutral-400"> (mín. {formatPrice(c.min_total)})</span>}
                  </td>
                  <td class="px-5 py-3 text-neutral-500">{c.used_count}{c.max_uses ? ` / ${c.max_uses}` : ''}</td>
                  <td class="px-5 py-3">
                    <span class:list={['rounded-full px-2.5 py-1 text-xs font-semibold capitalize', statusStyle[couponStatus(c)]]}>
                      {couponStatus(c)}
                    </span>
                  </td>
                  <td class="px-5 py-3">
                    <div class="flex items-center justify-end gap-1">
                      <form method="POST" class:list={{ hidden: ['vencido', 'agotado'].includes(couponStatus(c)) }}>
                        <input type="hidden" name="_action" value="toggle" />
                        <input type="hidden" name="id" value={c.id} />
                        <button type="submit" class="cursor-pointer rounded-lg px-3 py-1.5 text-xs font-semibold text-neutral-500 hover:bg-neutral-100">
                          {c.active ? 'Pausar' : 'Activar'}
                        </button>
                      </form>
                      <form method="POST" onsubmit={`return confirm('¿Eliminar el cupón «${c.code}»?')`}>
                        <input type="hidden" name="_action" value="delete" />
                        <input type="hidden" name="id" value={c.id} />
                        <button type="submit" class="cursor-pointer rounded-lg px-3 py-1.5 text-xs font-semibold text-rose-600 hover:bg-rose-50">
                          Eliminar
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </div>
    </div>

    <div>
      <div class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm">
        <h2 class="font-bold">Nuevo cupón</h2>
        {error && <p class="mt-4 rounded-xl bg-rose-50 px-4 py-3 text-sm font-medium text-rose-600">{error}</p>}
        <form method="POST" class="mt-4 space-y-4">
          <input type="hidden" name="_action" value="create" />
          <div>
            <label for="c-code" class="mb-1.5 block text-sm font-medium text-neutral-700">Código *</label>
            <input id="c-code" name="code" required class={`${input} uppercase`} placeholder="Ej: BIENVENIDA10" />
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="c-type" class="mb-1.5 block text-sm font-medium text-neutral-700">Tipo</label>
              <select id="c-type" name="type" class={input}>
                <option value="percent">% Porcentaje</option>
                <option value="fixed">Monto fijo</option>
              </select>
            </div>
            <div>
              <label for="c-value" class="mb-1.5 block text-sm font-medium text-neutral-700">Valor *</label>
              <input id="c-value" name="value" type="number" step="0.01" min="0" required class={input} />
            </div>
          </div>
          <div>
            <label for="c-min" class="mb-1.5 block text-sm font-medium text-neutral-700">Pedido mínimo</label>
            <input id="c-min" name="min_total" type="number" step="0.01" min="0" class={input} placeholder="0" />
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="c-max" class="mb-1.5 block text-sm font-medium text-neutral-700">Usos máx.</label>
              <input id="c-max" name="max_uses" type="number" min="1" class={input} placeholder="Sin límite" />
            </div>
            <div>
              <label for="c-exp" class="mb-1.5 block text-sm font-medium text-neutral-700">Vence</label>
              <input id="c-exp" name="expires_at" type="date" class={input} />
            </div>
          </div>
          <button type="submit" class="w-full cursor-pointer rounded-xl bg-neutral-900 py-3 font-semibold text-white transition-colors hover:bg-neutral-700">
            Crear cupón
          </button>
        </form>
      </div>
    </div>
  </div>
</AdminLayout>
