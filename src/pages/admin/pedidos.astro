---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb, PAYMENT_METHODS, isPaymentMethod, type Order, type OrderItem } from '../../lib/db';
import { formatPrice } from '../../lib/util';
import { approveOrder, advanceOrder, rejectOrder, cancelOrder, setOrderTracking } from '../../lib/orders';
import { logAudit } from '../../lib/audit';
import { formatLocal } from '../../lib/time';

const db = await getDb();
const me = Astro.locals.user!;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') ?? '');
  const id = Number(form.get('id'));
  // Volver a la misma vista (filtro, búsqueda y página) después de actuar
  const back = String(form.get('back') ?? '');
  const redirectTo = back.startsWith('/admin/pedidos') ? back : '/admin/pedidos';

  if (action === 'bulk_deliver') {
    const ids = form.getAll('ids').map(Number).filter(Number.isInteger).slice(0, 100);
    let done = 0;
    for (const orderId of ids) if (await advanceOrder(orderId, 'entregado')) done++;
    if (done > 0) await logAudit(me.name, `Marcó ${done} pedidos como entregados`, 'pedido', null, ids.map((i) => `#${i}`).join(', '));
    return Astro.redirect(redirectTo);
  }

  if (Number.isInteger(id)) {
    const method = String(form.get('payment_method') ?? '');
    const labels: Record<string, string> = {
      approve: 'Aprobó', reject: 'Rechazó', ship: 'Marcó enviado', deliver: 'Marcó entregado', cancel: 'Canceló',
    };
    let ok = false;
    if (action === 'approve') ok = await approveOrder(id, me, isPaymentMethod(method) ? method : '');
    else if (action === 'reject') ok = await rejectOrder(id);
    else if (action === 'ship') ok = await advanceOrder(id, 'enviado');
    else if (action === 'deliver') ok = await advanceOrder(id, 'entregado');
    else if (action === 'cancel') ok = await cancelOrder(id, me);
    else if (action === 'tracking') await setOrderTracking(id, String(form.get('tracking_code') ?? ''));
    if (ok && labels[action]) {
      await logAudit(me.name, `${labels[action]} el pedido`, 'pedido', id, isPaymentMethod(method) ? `Pago: ${PAYMENT_METHODS[method]}` : '');
    }
  }
  return Astro.redirect(redirectTo);
}

const filter = Astro.url.searchParams.get('estado') ?? '';
const VALID = ['pendiente', 'aprobado', 'enviado', 'entregado', 'cancelado', 'rechazado'];
const validFilter = VALID.includes(filter) ? filter : '';
const q = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 80);
const PAGE_SIZE = 20;
const page = Math.max(Math.floor(Number(Astro.url.searchParams.get('page'))) || 1, 1);

const where: string[] = [];
const args: (string | number)[] = [];
if (validFilter) {
  where.push('status = ?');
  args.push(validFilter);
}
if (q) {
  // Busca por nº de pedido ("#9" o "9"), nombre, teléfono, email o RUC
  const idMatch = q.match(/^#?(\d+)$/);
  where.push(`(${idMatch ? 'id = ? OR ' : ''}customer_name LIKE ? OR customer_phone LIKE ? OR customer_email LIKE ? OR customer_ruc LIKE ?)`);
  if (idMatch) args.push(Number(idMatch[1]));
  args.push(`%${q}%`, `%${q}%`, `%${q}%`, `%${q}%`);
}
const whereSql = where.length ? `WHERE ${where.join(' AND ')}` : '';

const [countRes, ordersRes] = await Promise.all([
  db.execute({ sql: `SELECT COUNT(*) AS n FROM orders ${whereSql}`, args }),
  db.execute({
    sql: `SELECT * FROM orders ${whereSql} ORDER BY id DESC LIMIT ? OFFSET ?`,
    args: [...args, PAGE_SIZE, (page - 1) * PAGE_SIZE],
  }),
]);
const totalOrders = Number(countRes.rows[0].n);
const totalPages = Math.max(Math.ceil(totalOrders / PAGE_SIZE), 1);
const orders = ordersRes.rows as unknown as Order[];
const deliverable = orders.filter((o) => o.status === 'aprobado' || o.status === 'enviado');

function pageUrl(n: number, estado = validFilter) {
  const p = new URLSearchParams();
  if (estado) p.set('estado', estado);
  if (q) p.set('q', q);
  if (n > 1) p.set('page', String(n));
  const s = p.toString();
  return s ? `/admin/pedidos?${s}` : '/admin/pedidos';
}
const back = Astro.url.pathname + Astro.url.search;

let itemsByOrder = new Map<number, OrderItem[]>();
if (orders.length > 0) {
  const placeholders = orders.map(() => '?').join(',');
  const itemsRes = await db.execute({
    sql: `SELECT * FROM order_items WHERE order_id IN (${placeholders}) ORDER BY id`,
    args: orders.map((o) => o.id),
  });
  for (const row of itemsRes.rows as unknown as OrderItem[]) {
    const list = itemsByOrder.get(row.order_id) ?? [];
    list.push(row);
    itemsByOrder.set(row.order_id, list);
  }
}

const statusStyle: Record<string, string> = {
  pendiente: 'bg-amber-50 text-amber-600',
  aprobado: 'bg-emerald-50 text-emerald-600',
  enviado: 'bg-sky-50 text-sky-600',
  entregado: 'bg-emerald-100 text-emerald-700',
  cancelado: 'bg-neutral-100 text-neutral-500',
  rechazado: 'bg-rose-50 text-rose-600',
};

const formatDate = (sqlDate: string) => formatLocal(sqlDate);

const filters = [
  { value: '', label: 'Todos' },
  { value: 'pendiente', label: 'Pendientes' },
  { value: 'aprobado', label: 'Aprobados' },
  { value: 'enviado', label: 'Enviados' },
  { value: 'entregado', label: 'Entregados' },
  { value: 'cancelado', label: 'Cancelados' },
  { value: 'rechazado', label: 'Rechazados' },
];

const btn = 'flex-1 cursor-pointer rounded-full px-4 py-2 text-sm font-semibold transition-colors';

// Link de WhatsApp al cliente con un mensaje según el estado del pedido
function waLink(o: Order): string | null {
  let phone = o.customer_phone.replace(/[^0-9]/g, '');
  if (!phone) return null;
  if (phone.startsWith('0')) phone = '595' + phone.slice(1);
  const messages: Record<string, string> = {
    pendiente: `¡Hola ${o.customer_name}! Recibimos tu pedido #${o.id} por ${formatPrice(o.total)} y lo estamos revisando. Te confirmamos en breve.`,
    aprobado: `¡Hola ${o.customer_name}! Tu pedido #${o.id} fue confirmado 🎉 Ya lo estamos preparando. Total: ${formatPrice(o.total)}.`,
    enviado: `¡Hola ${o.customer_name}! Tu pedido #${o.id} está en camino 🚚`,
    entregado: `¡Hola ${o.customer_name}! Registramos la entrega de tu pedido #${o.id}. ¡Gracias por tu compra! 🙌`,
    cancelado: `Hola ${o.customer_name}, tu pedido #${o.id} fue cancelado. Cualquier duda escribinos por acá.`,
    rechazado: `Hola ${o.customer_name}, lamentablemente no pudimos procesar tu pedido #${o.id}. Cualquier duda escribinos por acá.`,
  };
  const msg = messages[o.status];
  if (!msg) return null;
  return `https://wa.me/${phone}?text=${encodeURIComponent(msg)}`;
}
---

<AdminLayout title="Pedidos — NoteStore admin">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold tracking-tight">Pedidos</h1>
      <p class="mt-1 text-sm text-neutral-500">
        Aprobar descuenta stock y asigna nº de comprobante. Cancelar una venta repone el stock.
      </p>
    </div>
    <a
      href="/admin/pos"
      class="rounded-full bg-neutral-900 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-neutral-700"
    >
      + Venta manual
    </a>
  </div>

  <div class="mt-6 flex flex-wrap gap-2">
    {filters.map((f) => (
      <a
        href={pageUrl(1, f.value)}
        class:list={[
          'rounded-full px-4 py-1.5 text-sm font-medium transition-colors',
          validFilter === f.value
            ? 'bg-neutral-900 text-white'
            : 'border border-neutral-200 bg-white text-neutral-600 hover:bg-neutral-50',
        ]}
      >
        {f.label}
      </a>
    ))}
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-3">
    <form method="GET" class="flex min-w-64 flex-1 gap-2" role="search">
      {validFilter && <input type="hidden" name="estado" value={validFilter} />}
      <label for="q" class="sr-only">Buscar pedidos</label>
      <input
        id="q"
        name="q"
        type="search"
        value={q}
        placeholder="Buscar por nº, cliente, teléfono, email o RUC"
        class="min-w-0 flex-1 rounded-lg border border-neutral-200 bg-white px-3 py-2 text-sm outline-none focus:border-neutral-500"
      />
      <button type="submit" class="cursor-pointer rounded-lg border border-neutral-300 bg-white px-4 py-2 text-sm font-semibold hover:border-neutral-500">Buscar</button>
      {q && <a href={pageUrl(1)} class="self-center text-sm text-neutral-500 hover:underline">Limpiar</a>}
    </form>
    <p class="text-sm text-neutral-500">{totalOrders} {totalOrders === 1 ? 'pedido' : 'pedidos'}</p>
  </div>

  {deliverable.length > 0 && (
    <form id="bulk-form" method="POST" class="mt-4 flex flex-wrap items-center gap-3 rounded-lg border border-neutral-200 bg-white px-4 py-2.5 text-sm"
      onsubmit="if (!document.querySelector('input[form=bulk-form]:checked')) { alert('Elegí al menos un pedido.'); return false; } return confirm('¿Marcar los pedidos elegidos como entregados?');">
      <input type="hidden" name="_action" value="bulk_deliver" />
      <input type="hidden" name="back" value={back} />
      <label class="flex cursor-pointer items-center gap-2">
        <input type="checkbox" id="bulk-all" class="size-4 accent-neutral-900" />
        Seleccionar aprobados/enviados de esta página
      </label>
      <button type="submit" class="ml-auto cursor-pointer rounded-lg bg-neutral-900 px-3 py-1.5 text-xs font-semibold text-white hover:bg-neutral-700">
        Marcar seleccionados como entregados
      </button>
    </form>
  )}

  {orders.length === 0 ? (
    <div class="mt-8 rounded-2xl border border-dashed border-neutral-300 bg-white p-16 text-center">
      <p class="text-lg font-semibold text-neutral-700">{q ? `Sin resultados para «${q}»` : 'No hay pedidos'}{validFilter && ` con estado «${validFilter}»`}</p>
      <p class="mt-1 text-sm text-neutral-500">
        Los pedidos del carrito y las ventas manuales aparecen acá.
      </p>
    </div>
  ) : (
    <div class="mt-8 space-y-5">
      {orders.map((o) => (
        <article class="overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-sm">
          <header class="flex flex-wrap items-center gap-x-4 gap-y-2 border-b border-neutral-100 bg-neutral-50/60 px-5 py-4">
            {(o.status === 'aprobado' || o.status === 'enviado') && (
              <input type="checkbox" name="ids" value={o.id} form="bulk-form" class="bulk-item size-4 accent-neutral-900" aria-label={`Seleccionar pedido #${o.id}`} />
            )}
            <p class="font-bold">Pedido #{o.id}</p>
            <span class:list={['rounded-full px-2.5 py-0.5 text-xs font-semibold capitalize', statusStyle[o.status]]}>
              {o.status}
            </span>
            {o.source === 'manual' && (
              <span class="rounded-full bg-neutral-900 px-2.5 py-0.5 text-xs font-semibold text-white">Mostrador</span>
            )}
            {o.invoice_number && (
              <span class="text-xs font-semibold text-neutral-400">Comprobante Nº {String(o.invoice_number).padStart(7, '0')}</span>
            )}
            <p class="text-sm text-neutral-500">{formatDate(o.created_at)}</p>
            <div class="ml-auto text-right">
              <p class="text-xs text-neutral-400 uppercase">Total</p>
              <p class="font-extrabold">{formatPrice(o.total)}</p>
            </div>
          </header>

          <div class="grid gap-5 px-5 py-4 md:grid-cols-3">
            <div class="md:col-span-2">
              <ul class="divide-y divide-neutral-100">
                {(itemsByOrder.get(o.id) ?? []).map((item) => (
                  <li class="flex items-center justify-between gap-3 py-2 text-sm">
                    <span>
                      {item.product_name}
                      {item.variant_label && <span class="text-neutral-400"> ({item.variant_label})</span>}
                      <span class="ml-1 rounded-md bg-neutral-100 px-1.5 py-0.5 text-xs font-semibold text-neutral-600">
                        x{item.qty}
                      </span>
                    </span>
                    <span class="font-semibold whitespace-nowrap">{formatPrice(item.price * item.qty)}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="flex flex-col justify-between gap-4 md:border-l md:border-neutral-100 md:pl-5">
              <div class="text-sm">
                <p class="text-xs text-neutral-400 uppercase">Cliente</p>
                <p class="mt-1 font-semibold">{o.customer_name}</p>
                {o.customer_email && <p class="text-neutral-500">{o.customer_email}</p>}
                {o.customer_phone && <p class="text-neutral-500">Tel. {o.customer_phone}</p>}
                {isPaymentMethod(o.payment_method) && (
                  <p class="mt-1 text-xs text-neutral-500">Pago: {PAYMENT_METHODS[o.payment_method]}</p>
                )}
                {o.customer_ruc && <p class="text-neutral-500">RUC: {o.customer_ruc}</p>}
                {o.seller_name && (
                  <p class="mt-1 text-xs text-neutral-400">Vendedor: {o.seller_name}</p>
                )}
                {o.discount > 0 && (
                  <p class="mt-1 text-xs text-neutral-400">Cupón {o.coupon_code}: -{formatPrice(o.discount)}</p>
                )}
                {o.shipping_cost > 0 && (
                  <p class="text-xs text-neutral-400">Envío ({o.shipping_zone}): {formatPrice(o.shipping_cost)}</p>
                )}
                {['aprobado', 'enviado', 'entregado'].includes(o.status) && (
                  <form method="POST" class="mt-2 flex gap-1.5">
                    <input type="hidden" name="_action" value="tracking" />
                    <input type="hidden" name="id" value={o.id} />
                      <input type="hidden" name="back" value={back} />
                    <input
                      name="tracking_code"
                      value={o.tracking_code}
                      placeholder="Código de seguimiento"
                      class="min-w-0 flex-1 rounded-lg border border-neutral-200 px-2.5 py-1.5 text-xs outline-none focus:border-neutral-500"
                    />
                    <button type="submit" class="cursor-pointer rounded-lg border border-neutral-200 px-2.5 py-1.5 text-xs font-semibold hover:bg-neutral-50">
                      Guardar
                    </button>
                  </form>
                )}
                {waLink(o) && (
                  <a
                    href={waLink(o)}
                    target="_blank"
                    rel="noopener"
                    class="mt-2 inline-flex items-center gap-1.5 rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-xs font-semibold text-emerald-700 transition-colors hover:bg-emerald-100"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-3.5"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
                    Avisar por WhatsApp
                  </a>
                )}
              </div>

              <div class="flex flex-wrap gap-2">
                {o.status === 'pendiente' && (
                  <>
                    <form method="POST" class="flex w-full gap-2">
                      <input type="hidden" name="_action" value="approve" />
                      <input type="hidden" name="id" value={o.id} />
                      <input type="hidden" name="back" value={back} />
                      <label class="sr-only" for={`pm-${o.id}`}>Medio de pago</label>
                      <select id={`pm-${o.id}`} name="payment_method" class="min-w-0 flex-1 rounded-lg border border-neutral-200 bg-white px-2 py-2 text-sm">
                        <option value="">Medio de pago…</option>
                        {Object.entries(PAYMENT_METHODS).map(([k, v]) => <option value={k}>{v}</option>)}
                      </select>
                      <button type="submit" class:list={[btn, 'flex-none bg-emerald-600 text-white hover:bg-emerald-500']}>
                        Aprobar
                      </button>
                    </form>
                    <form method="POST" class="flex-1" onsubmit={`return confirm('¿Rechazar el pedido #${o.id}?')`}>
                      <input type="hidden" name="_action" value="reject" />
                      <input type="hidden" name="id" value={o.id} />
                      <input type="hidden" name="back" value={back} />
                      <button type="submit" class:list={[btn, 'w-full border border-rose-200 text-rose-600 hover:bg-rose-50']}>
                        Rechazar
                      </button>
                    </form>
                  </>
                )}
                {o.status === 'aprobado' && (
                  <form method="POST" class="flex-1">
                    <input type="hidden" name="_action" value="ship" />
                    <input type="hidden" name="id" value={o.id} />
                      <input type="hidden" name="back" value={back} />
                    <button type="submit" class:list={[btn, 'w-full bg-sky-600 text-white hover:bg-sky-500']}>
                      Marcar enviado
                    </button>
                  </form>
                )}
                {(o.status === 'aprobado' || o.status === 'enviado') && (
                  <form method="POST" class="flex-1">
                    <input type="hidden" name="_action" value="deliver" />
                    <input type="hidden" name="id" value={o.id} />
                      <input type="hidden" name="back" value={back} />
                    <button type="submit" class:list={[btn, 'w-full bg-emerald-700 text-white hover:bg-emerald-600']}>
                      Marcar entregado
                    </button>
                  </form>
                )}
                {['aprobado', 'enviado', 'entregado'].includes(o.status) && (
                  <>
                    <a
                      href={`/admin/factura/${o.id}`}
                      target="_blank"
                      class:list={[btn, 'border border-neutral-200 text-center text-neutral-700 hover:bg-neutral-50']}
                    >
                      Factura
                    </a>
                    <form
                      method="POST"
                      class="flex-1"
                      onsubmit={`return confirm('¿Cancelar el pedido #${o.id}? Se repone el stock de sus productos.')`}
                    >
                      <input type="hidden" name="_action" value="cancel" />
                      <input type="hidden" name="id" value={o.id} />
                      <input type="hidden" name="back" value={back} />
                      <button type="submit" class:list={[btn, 'w-full border border-rose-200 text-rose-600 hover:bg-rose-50']}>
                        Cancelar
                      </button>
                    </form>
                  </>
                )}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  )}

  {totalPages > 1 && (
    <nav class="mt-8 flex items-center justify-between gap-4 text-sm" aria-label="Paginación">
      {page > 1 ? <a href={pageUrl(page - 1)} class="rounded-lg border border-neutral-300 bg-white px-4 py-2 font-semibold hover:border-neutral-500">← Anteriores</a> : <span></span>}
      <span class="text-neutral-500">Página {page} de {totalPages}</span>
      {page < totalPages ? <a href={pageUrl(page + 1)} class="rounded-lg border border-neutral-300 bg-white px-4 py-2 font-semibold hover:border-neutral-500">Siguientes →</a> : <span></span>}
    </nav>
  )}

  <script is:inline>
    document.getElementById('bulk-all')?.addEventListener('change', (e) => {
      document.querySelectorAll('.bulk-item').forEach((c) => (c.checked = e.target.checked));
    });
  </script>
</AdminLayout>
