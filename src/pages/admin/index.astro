---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb, SOLD_SQL } from '../../lib/db';
import { formatPrice } from '../../lib/util';
import { LOCAL_NOW as localNow, localSql as localAt } from '../../lib/time';
import { deactivateStaleCoupons } from '../../lib/coupons';
import { logAudit } from '../../lib/audit';
import { monthlyFinance, getSalesGoal, projectMonth } from '../../lib/finance';
import { localToday, lastMonths, monthLabel } from '../../lib/time';

const db = await getDb();
const user = Astro.locals.user;
const isAdmin = Boolean(user?.is_admin);

// Los cupones vencidos o agotados se desactivan solos
const autoOff = await deactivateStaleCoupons();
if (autoOff.length > 0) await logAudit('Sistema', 'Desactivó cupones vencidos/agotados', 'cupon', null, autoOff.join(', '));

const [pendingRes, toShipRes, lowStockRes, reviewsRes, cashRes, recentRes, mySalesRes, noMinRes] = await Promise.all([
  db.execute(`SELECT COUNT(*) AS n, MIN(created_at) AS oldest FROM orders WHERE status = 'pendiente'`),
  db.execute(`SELECT COUNT(*) AS n FROM orders WHERE status = 'aprobado' AND source = 'web'`),
  db.execute(
    `SELECT id, name, image_url, stock, min_stock, COUNT(*) OVER () AS total
     FROM products WHERE stock <= 0 OR (min_stock > 0 AND stock <= min_stock)
     ORDER BY stock ASC, name LIMIT 5`
  ),
  db.execute(`SELECT COUNT(*) AS n FROM reviews WHERE approved = 0`),
  // Días con ventas en los últimos 7 días (sin contar hoy) que no tienen cierre de caja
  db.execute(
    `SELECT COUNT(DISTINCT date(created_at, '-3 hours')) AS n FROM orders
     WHERE status IN ${SOLD_SQL}
       AND date(created_at, '-3 hours') BETWEEN date(${localNow}, '-7 days') AND date(${localNow}, '-1 day')
       AND date(created_at, '-3 hours') NOT IN (SELECT close_date FROM cash_closings)`
  ),
  db.execute(
    `SELECT id, customer_name, status, source, total, created_at
     FROM orders ORDER BY created_at DESC, id DESC LIMIT 6`
  ),
  db.execute({
    sql: `SELECT COUNT(*) AS n, COALESCE(SUM(total), 0) AS revenue FROM orders
          WHERE status IN ${SOLD_SQL} AND seller_name = ?
            AND ${localAt('created_at')} >= datetime(${localNow}, 'start of month')`,
    args: [user?.name ?? ''],
  }),
  db.execute('SELECT COUNT(*) AS n FROM products WHERE min_stock = 0'),
]);

const pending = { n: Number(pendingRes.rows[0].n), oldest: pendingRes.rows[0].oldest as string | null };
const toShip = Number(toShipRes.rows[0].n);
const lowStock = lowStockRes.rows as unknown as { id: number; name: string; image_url: string; stock: number; min_stock: number }[];
const lowStockTotal = Number(lowStockRes.rows[0]?.total ?? 0);
const reviewsPending = Number(reviewsRes.rows[0].n);
const unclosedDays = Number(cashRes.rows[0].n);
const noMin = Number(noMinRes.rows[0].n);
const recent = recentRes.rows as unknown as { id: number; customer_name: string; status: string; source: string; total: number; created_at: string }[];
const mySales = { n: Number(mySalesRes.rows[0].n), revenue: Number(mySalesRes.rows[0].revenue) };

function daysSince(utc: string | null) {
  if (!utc) return 0;
  return Math.floor((Date.now() - new Date(`${utc.replace(' ', 'T')}Z`).getTime()) / 86_400_000);
}

const attention = [
  {
    label: 'Pedidos por confirmar',
    value: pending.n,
    detail: pending.n > 0 ? `El más antiguo espera hace ${daysSince(pending.oldest)} días` : 'Ninguno en espera',
    href: '/admin/pedidos?estado=pendiente',
  },
  {
    label: 'Aprobados sin enviar',
    value: toShip,
    detail: 'Pedidos web confirmados que no se marcaron como enviados',
    href: '/admin/pedidos?estado=aprobado',
  },
  {
    label: 'Stock crítico',
    value: lowStockTotal,
    detail: 'Sin stock o por debajo del mínimo',
    href: '/admin/inventario',
  },
  {
    label: 'Cajas sin cerrar',
    value: unclosedDays,
    detail: 'Días con ventas de la última semana sin cierre de caja',
    href: '/admin/caja',
  },
  ...(isAdmin
    ? [
        { label: 'Reseñas por moderar', value: reviewsPending, detail: 'Esperando aprobación', href: '/admin/resenas' },
        { label: 'Sin stock mínimo', value: noMin, detail: 'Productos que nunca avisan antes de agotarse', href: '/admin/inventario' },
      ]
    : []),
];

const statusInfo: Record<string, { style: string; label: string }> = {
  pendiente: { style: 'bg-amber-50 text-amber-700', label: 'Pendiente' },
  aprobado: { style: 'bg-emerald-50 text-emerald-700', label: 'Aprobado' },
  enviado: { style: 'bg-sky-50 text-sky-700', label: 'Enviado' },
  entregado: { style: 'bg-neutral-100 text-neutral-700', label: 'Entregado' },
  cancelado: { style: 'bg-neutral-100 text-neutral-500', label: 'Cancelado' },
  rechazado: { style: 'bg-rose-50 text-rose-700', label: 'Rechazado' },
};

const dateFmt = new Intl.DateTimeFormat('es-PY', { day: 'numeric', month: 'short', timeZone: 'America/Asuncion' });
const fmtDate = (utc: string) => dateFmt.format(new Date(`${utc.replace(' ', 'T')}Z`));

// ---------- Números del negocio (solo admin) ----------
type Biz = {
  today: { revenue: number; n: number };
  mtd: { revenue: number; n: number; avg: number };
  prevMtd: number;
  change: number | null;
  grossMonth: number;
  marginMonth: number | null;
  expensesMonth: number;
  resultMonth: number;
  totalRevenue: number;
  netAllTime: number;
  months: { label: string; revenue: number; n: number }[];
  maxMonthly: number;
  channels: { label: string; revenue: number; n: number }[];
  top: { name: string; units: number; revenue: number }[];
  idle: { id: number; name: string; stock: number; capital: number }[];
  idleCount: number;
  idleCapital: number;
  sellers: { name: string; n: number; revenue: number; monthRevenue: number }[];
  maxSeller: number;
};
let biz: Biz | null = null;

if (isAdmin) {
  const sold = `WITH s AS (
      SELECT o.*, ${localAt('o.created_at')} AS l FROM orders o WHERE o.status IN ${SOLD_SQL}
    ), n AS (SELECT ${localNow} AS now)`;

  const [periodRes, finance, expensesRes, totalsRes, monthlyRes, channelRes, topRes, idleRes, sellersRes] = await Promise.all([
    db.execute(
      `${sold}
       SELECT
         COALESCE(SUM(CASE WHEN date(l) = date(now) THEN total END), 0) AS today_rev,
         SUM(CASE WHEN date(l) = date(now) THEN 1 ELSE 0 END) AS today_n,
         COALESCE(SUM(CASE WHEN l >= datetime(now, 'start of month') THEN total END), 0) AS mtd_rev,
         SUM(CASE WHEN l >= datetime(now, 'start of month') THEN 1 ELSE 0 END) AS mtd_n,
         COALESCE(SUM(CASE WHEN l >= datetime(now, 'start of month', '-1 month') AND l < datetime(now, '-1 month') THEN total END), 0) AS prev_rev
       FROM s, n`
    ),
    // Mismo cálculo que la página de Finanzas, para que los números coincidan
    monthlyFinance(1),
    db.execute(`SELECT COALESCE(SUM(amount), 0) AS total FROM expenses`),
    db.execute(
      `SELECT
         (SELECT COALESCE(SUM(total), 0) FROM orders WHERE status IN ${SOLD_SQL}) AS revenue,
         (SELECT COALESCE(SUM((oi.price - oi.cost) * oi.qty), 0) FROM order_items oi
            JOIN orders o ON o.id = oi.order_id WHERE o.status IN ${SOLD_SQL} AND oi.cost > 0) AS gross`
    ),
    db.execute(
      `${sold}
       SELECT strftime('%Y-%m', l) AS ym, COALESCE(SUM(total), 0) AS revenue, COUNT(*) AS n
       FROM s, n WHERE l >= datetime(now, 'start of month', '-5 months') GROUP BY ym`
    ),
    db.execute(
      `${sold}
       SELECT source, COALESCE(SUM(total), 0) AS revenue, COUNT(*) AS n
       FROM s, n WHERE l >= datetime(now, 'start of month', '-2 months') GROUP BY source`
    ),
    db.execute(
      `${sold}
       SELECT oi.product_name AS name, SUM(oi.qty) AS units, SUM(oi.price * oi.qty) AS revenue
       FROM order_items oi JOIN s ON s.id = oi.order_id, n
       WHERE s.l >= datetime(n.now, '-90 days')
       GROUP BY COALESCE(oi.product_id, oi.product_name) ORDER BY units DESC, revenue DESC LIMIT 5`
    ),
    db.execute(
      `SELECT p.id, p.name, p.stock, p.stock * p.cost AS capital,
              COUNT(*) OVER () AS total, SUM(p.stock * p.cost) OVER () AS total_capital
       FROM products p
       WHERE p.stock > 0 AND NOT EXISTS (
         SELECT 1 FROM order_items oi JOIN orders o ON o.id = oi.order_id
         WHERE oi.product_id = p.id AND o.status IN ${SOLD_SQL} AND o.created_at >= datetime('now', '-90 days'))
       ORDER BY capital DESC LIMIT 5`
    ),
    db.execute(
      `${sold}
       SELECT seller_name, COUNT(*) AS n, COALESCE(SUM(total), 0) AS revenue,
              COALESCE(SUM(CASE WHEN l >= datetime(now, 'start of month') THEN total END), 0) AS month_revenue
       FROM s, n WHERE seller_name != ''
       GROUP BY seller_name ORDER BY revenue DESC LIMIT 5`
    ),
  ]);

  const p = periodRes.rows[0];
  const mtdRevenue = Number(p.mtd_rev);
  const mtdN = Number(p.mtd_n ?? 0);
  const prevMtd = Number(p.prev_rev);
  const month = finance[0];

  const monthlyMap = new Map(monthlyRes.rows.map((r) => [String(r.ym), { revenue: Number(r.revenue), n: Number(r.n) }]));
  const months = lastMonths(6).map((ym) => ({ label: monthLabel(ym), ...(monthlyMap.get(ym) ?? { revenue: 0, n: 0 }) }));

  const channelLabel: Record<string, string> = { web: 'Tienda online', manual: 'Mostrador' };
  const sellers = sellersRes.rows.map((r) => ({
    name: String(r.seller_name),
    n: Number(r.n),
    revenue: Number(r.revenue),
    monthRevenue: Number(r.month_revenue),
  }));

  biz = {
    today: { revenue: Number(p.today_rev), n: Number(p.today_n ?? 0) },
    mtd: { revenue: mtdRevenue, n: mtdN, avg: mtdN > 0 ? Math.round(mtdRevenue / mtdN) : 0 },
    prevMtd,
    change: prevMtd > 0 ? Math.round(((mtdRevenue - prevMtd) / prevMtd) * 100) : null,
    grossMonth: month.gross,
    marginMonth: month.sales > 0 ? Math.round((month.gross / month.sales) * 100) : null,
    expensesMonth: month.expenses,
    resultMonth: month.net,
    totalRevenue: Number(totalsRes.rows[0].revenue),
    netAllTime: Number(totalsRes.rows[0].gross) - Number(expensesRes.rows[0].total),
    months,
    maxMonthly: Math.max(...months.map((m) => m.revenue), 1),
    channels: channelRes.rows
      .map((r) => ({ label: channelLabel[String(r.source)] ?? String(r.source), revenue: Number(r.revenue), n: Number(r.n) }))
      .sort((a, b) => b.revenue - a.revenue),
    top: topRes.rows.map((r) => ({ name: String(r.name), units: Number(r.units), revenue: Number(r.revenue) })),
    idle: idleRes.rows.map((r) => ({ id: Number(r.id), name: String(r.name), stock: Number(r.stock), capital: Number(r.capital) })),
    idleCount: Number(idleRes.rows[0]?.total ?? 0),
    idleCapital: Number(idleRes.rows[0]?.total_capital ?? 0),
    sellers,
    maxSeller: Math.max(...sellers.map((s) => s.revenue), 1),
  };
}

const channelTotal = biz ? biz.channels.reduce((a, c) => a + c.revenue, 0) : 0;

// Textos y medidas de los gráficos, resueltos acá para mantener el markup simple
const change = biz?.change ?? null;
const changeText =
  change == null
    ? 'Sin ventas a esta altura del mes pasado'
    : `${change >= 0 ? '▲' : '▼'} ${Math.abs(change)}% vs. mismo período del mes pasado`;
const changeClass = change == null ? 'text-neutral-500' : change >= 0 ? 'text-emerald-700' : 'text-rose-700';
const marginText = biz?.marginMonth != null ? ` (${biz.marginMonth}%)` : '';

const monthBars = (biz?.months ?? []).map((m, i, all) => ({
  ...m,
  value: m.revenue > 0 ? `${(m.revenue / 1_000_000).toFixed(1).replace('.', ',')} M` : '',
  height: m.revenue > 0 ? Math.max(Math.round((m.revenue / biz!.maxMonthly) * 100), 3) : 1,
  current: i === all.length - 1,
  title: `${m.label}: ${formatPrice(m.revenue)} · ${m.n} ${m.n === 1 ? 'venta' : 'ventas'}`,
}));
const channelRows = (biz?.channels ?? []).map((c) => ({ ...c, pct: Math.round((c.revenue / channelTotal) * 100) }));
const sellerRows = (biz?.sellers ?? []).map((s) => ({ ...s, pct: Math.max(Math.round((s.revenue / biz!.maxSeller) * 100), 3) }));

const goal = biz ? await getSalesGoal() : 0;
const goalPct = goal > 0 && biz ? Math.min(Math.round((biz.mtd.revenue / goal) * 100), 100) : 0;
const goalText = goal > 0 && biz
  ? `${goalPct}% de la meta · proyección ${formatPrice(projectMonth(biz.mtd.revenue, localToday()).projection)}`
  : '';
const todayLabel = new Intl.DateTimeFormat('es-PY', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'America/Asuncion' }).format(new Date());

const card = 'min-w-0 rounded-2xl border border-neutral-200 bg-white p-5';
const cardTitle = 'text-sm font-semibold text-neutral-900';
const muted = 'text-xs text-neutral-500';
---

<AdminLayout title="Dashboard — NoteStore admin">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-sm text-neutral-500 first-letter:uppercase">{todayLabel}</p>
      <h1 class="mt-0.5 text-2xl font-bold tracking-tight">Hola, {user?.name?.split(' ')[0]}</h1>
    </div>
    <div class="flex flex-wrap gap-2">
      <a href="/admin/pos" class="rounded-lg border border-neutral-300 bg-white px-4 py-2 text-sm font-semibold transition-colors hover:border-neutral-500">
        Nueva venta
      </a>
      <a href="/admin/productos/nuevo" class="rounded-lg bg-neutral-900 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-neutral-700">
        Nuevo producto
      </a>
    </div>
  </div>

  <!-- Requiere atención -->
  <section class="mt-8" aria-labelledby="attention-title">
    <h2 id="attention-title" class="text-xs font-semibold tracking-wide text-neutral-500 uppercase">Requiere atención</h2>
    <div class:list={['mt-3 grid grid-cols-2 gap-3', isAdmin ? 'lg:grid-cols-3 xl:grid-cols-6' : 'lg:grid-cols-4']}>
      {attention.map((a) => (
        <a
          href={a.href}
          class:list={[
            'group relative rounded-2xl border bg-white p-4 transition-colors',
            a.value > 0 ? 'border-amber-300 hover:border-amber-500' : 'border-neutral-200 hover:border-neutral-400',
          ]}
        >
          <p class="text-sm text-neutral-600">{a.label}</p>
          <p class:list={['mt-1 text-3xl font-bold tabular-nums', a.value > 0 ? 'text-amber-700' : 'text-neutral-300']}>{a.value}</p>
          <p class="mt-1 text-xs leading-snug text-neutral-500">{a.value > 0 ? a.detail : 'Al día'}</p>
        </a>
      ))}
    </div>
  </section>

  {!isAdmin && (
    <section class="mt-6 grid gap-3 sm:grid-cols-2">
      <div class={card}>
        <p class={cardTitle}>Tus ventas este mes</p>
        <p class="mt-2 text-2xl font-bold">{formatPrice(mySales.revenue)}</p>
        <p class={muted}>{mySales.n} {mySales.n === 1 ? 'venta registrada' : 'ventas registradas'} a tu nombre</p>
      </div>
      <a href="/admin/pos" class:list={[card, 'flex flex-col justify-center transition-colors hover:border-neutral-400']}>
        <p class={cardTitle}>Registrar venta de mostrador →</p>
        <p class:list={[muted, 'mt-1']}>Descuenta stock y genera la factura.</p>
      </a>
    </section>
  )}

  {biz && (
    <>
      <!-- Indicadores del mes -->
      <section class="mt-10" aria-labelledby="kpi-title">
        <div class="flex items-baseline justify-between">
          <h2 id="kpi-title" class="text-xs font-semibold tracking-wide text-neutral-500 uppercase">Este mes</h2>
          <a href="/admin/metricas" class="text-sm font-semibold text-neutral-900 hover:underline">Métricas completas →</a>
        </div>
        <div class="mt-3 grid grid-cols-2 gap-3 lg:grid-cols-4">
          <div class={card}>
            <p class="text-sm text-neutral-500">Ventas del mes</p>
            <p class="mt-1 text-2xl font-bold tabular-nums">{formatPrice(biz.mtd.revenue)}</p>
            <p class:list={['mt-1 text-xs', changeClass]}>{changeText}</p>
            {goal > 0 ? (
              <a href="/admin/finanzas" class="mt-3 block" title="Ver en Finanzas">
                <span class="block h-1.5 overflow-hidden rounded-full bg-neutral-100">
                  <span class="block h-full bg-neutral-900" style={`width: ${goalPct}%`}></span>
                </span>
                <span class="mt-1 block text-xs text-neutral-500">{goalText}</span>
              </a>
            ) : (
              <a href="/admin/finanzas" class="mt-3 block text-xs text-neutral-500 underline">Definir meta mensual</a>
            )}
          </div>
          <div class={card}>
            <p class="text-sm text-neutral-500">Hoy</p>
            <p class="mt-1 text-2xl font-bold tabular-nums">{formatPrice(biz.today.revenue)}</p>
            <p class={muted}>{biz.today.n} {biz.today.n === 1 ? 'venta' : 'ventas'}</p>
          </div>
          <div class={card}>
            <p class="text-sm text-neutral-500">Ticket promedio</p>
            <p class="mt-1 text-2xl font-bold tabular-nums">{formatPrice(biz.mtd.avg)}</p>
            <p class={muted}>{biz.mtd.n} {biz.mtd.n === 1 ? 'venta' : 'ventas'} en el mes</p>
          </div>
          <div class={card}>
            <p class="text-sm text-neutral-500">Resultado del mes</p>
            <p class:list={['mt-1 text-2xl font-bold tabular-nums', biz.resultMonth < 0 ? 'text-rose-700' : '']}>{formatPrice(biz.resultMonth)}</p>
            <p class={muted} title="Ganancia bruta de productos con costo cargado, menos gastos del mes">
              Bruta {formatPrice(biz.grossMonth)}{marginText} − gastos {formatPrice(biz.expensesMonth)}
            </p>
          </div>
        </div>
      </section>

      <!-- Tendencia y canales -->
      <section class="mt-3 grid gap-3 lg:grid-cols-3">
        <div class:list={[card, 'lg:col-span-2']}>
          <div class="flex items-baseline justify-between gap-4">
            <p class={cardTitle}>Ventas de los últimos 6 meses</p>
            <p class={muted}>Histórico: {formatPrice(biz.totalRevenue)} · neto {formatPrice(biz.netAllTime)}</p>
          </div>
          <div class="mt-5 grid h-40 grid-cols-6 items-end gap-3">
            {monthBars.map((m) => (
              <div class="flex h-full flex-col justify-end gap-1.5">
                <p class="text-center text-[11px] font-medium text-neutral-600 tabular-nums">{m.value}</p>
                <div
                  class:list={['w-full rounded-t', m.current ? 'bg-neutral-900' : 'bg-neutral-300']}
                  style={`height: ${m.height}%`}
                  title={m.title}
                ></div>
                <p class="text-center text-xs text-neutral-500 capitalize">{m.label}</p>
              </div>
            ))}
          </div>
        </div>

        <div class={card}>
          <p class={cardTitle}>Canal de venta</p>
          <p class={muted}>Últimos 3 meses</p>
          {biz.channels.length === 0 ? (
            <p class="mt-6 text-sm text-neutral-500">Sin ventas en los últimos 3 meses.</p>
          ) : (
            <>
              <div class="mt-4 flex h-2.5 overflow-hidden rounded-full bg-neutral-100">
                {channelRows.map((c, i) => (
                  <div class={i === 0 ? 'bg-neutral-900' : 'bg-neutral-400'} style={`width: ${c.pct}%`}></div>
                ))}
              </div>
              <ul class="mt-4 space-y-2.5 text-sm">
                {channelRows.map((c, i) => (
                  <li class="flex items-center gap-2">
                    <span class:list={['size-2.5 rounded-sm', i === 0 ? 'bg-neutral-900' : 'bg-neutral-400']}></span>
                    <span class="flex-1">{c.label}</span>
                    <span class="text-neutral-500 tabular-nums">{c.pct}%</span>
                    <span class="shrink-0 text-right font-medium whitespace-nowrap tabular-nums sm:w-28">{formatPrice(c.revenue)}</span>
                  </li>
                ))}
              </ul>
            </>
          )}
        </div>
      </section>

      <!-- Productos -->
      <section class="mt-3 grid gap-3 lg:grid-cols-2">
        <div class={card}>
          <div class="flex items-baseline justify-between">
            <p class={cardTitle}>Más vendidos</p>
            <p class={muted}>Últimos 90 días</p>
          </div>
          {biz.top.length === 0 ? (
            <p class="mt-4 text-sm text-neutral-500">Sin ventas en los últimos 90 días.</p>
          ) : (
            <ol class="mt-3 divide-y divide-neutral-100 text-sm">
              {biz.top.map((t, i) => (
                <li class="flex items-center gap-3 py-2">
                  <span class="w-4 text-xs text-neutral-400 tabular-nums">{i + 1}</span>
                  <span class="min-w-0 flex-1 truncate">{t.name}</span>
                  <span class="text-neutral-500 tabular-nums">{t.units} u.</span>
                  <span class="shrink-0 text-right font-medium whitespace-nowrap tabular-nums sm:w-28">{formatPrice(t.revenue)}</span>
                </li>
              ))}
            </ol>
          )}
        </div>

        <div class={card}>
          <div class="flex items-baseline justify-between gap-4">
            <p class={cardTitle}>Sin ventas en 90 días</p>
            <p class={muted}>{biz.idleCount} productos · {formatPrice(biz.idleCapital)} a costo</p>
          </div>
          {biz.idle.length === 0 ? (
            <p class="mt-4 text-sm text-neutral-500">Todo el stock tuvo movimiento en los últimos 90 días.</p>
          ) : (
            <>
              <ul class="mt-3 divide-y divide-neutral-100 text-sm">
                {biz.idle.map((p) => (
                  <li class="flex items-center gap-3 py-2">
                    <a href={`/admin/productos/${p.id}`} class="min-w-0 flex-1 truncate hover:underline">{p.name}</a>
                    <span class="text-neutral-500 tabular-nums">{p.stock} u.</span>
                    <span class="shrink-0 text-right font-medium whitespace-nowrap tabular-nums sm:w-28">{p.capital > 0 ? formatPrice(p.capital) : '—'}</span>
                  </li>
                ))}
              </ul>
              <p class="mt-2 text-xs text-neutral-500">Candidatos a oferta o cupón. Ordenados por capital inmovilizado.</p>
            </>
          )}
        </div>
      </section>

      {biz.sellers.length > 0 && (
        <section class:list={[card, 'mt-3']}>
          <div class="flex items-baseline justify-between">
            <p class={cardTitle}>Ventas por vendedor</p>
            <p class={muted}>Solo ventas con vendedor asignado</p>
          </div>
          <ul class="mt-4 space-y-3">
            {sellerRows.map((s) => (
              <li class="text-sm">
                <div class="flex items-baseline justify-between gap-3">
                  <p class="truncate font-medium">{s.name}</p>
                  <p class="font-semibold whitespace-nowrap tabular-nums">{formatPrice(s.revenue)}</p>
                </div>
                <div class="mt-1 flex items-center gap-3">
                  <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-neutral-100">
                    <div class="h-full rounded-full bg-neutral-900" style={`width: ${s.pct}%`}></div>
                  </div>
                  <p class="text-xs whitespace-nowrap text-neutral-500">
                    {s.n} {s.n === 1 ? 'venta' : 'ventas'} · este mes {formatPrice(s.monthRevenue)}
                  </p>
                </div>
              </li>
            ))}
          </ul>
        </section>
      )}
    </>
  )}

  <!-- Operación -->
  <section class="mt-3 grid gap-3 lg:grid-cols-5">
    <div class:list={[card, 'lg:col-span-3']}>
      <div class="flex items-baseline justify-between">
        <p class={cardTitle}>Últimos pedidos</p>
        <a href="/admin/pedidos" class="text-sm font-semibold text-neutral-900 hover:underline">Ver todos</a>
      </div>
      {recent.length === 0 ? (
        <p class="mt-4 text-sm text-neutral-500">Todavía no hay pedidos.</p>
      ) : (
        <ul class="mt-3 divide-y divide-neutral-100 text-sm">
          {recent.map((o) => {
            const st = statusInfo[o.status] ?? { style: 'bg-neutral-100 text-neutral-600', label: o.status };
            return (
              <li class="flex items-center gap-3 py-2.5">
                <span class="w-10 text-xs text-neutral-400 tabular-nums">#{o.id}</span>
                <div class="min-w-0 flex-1">
                  <p class="truncate font-medium">{o.customer_name || 'Sin nombre'}</p>
                  <p class="text-xs text-neutral-500">{fmtDate(o.created_at)} · {o.source === 'manual' ? 'Mostrador' : 'Web'}</p>
                </div>
                <span class:list={['rounded-md px-2 py-0.5 text-xs font-medium', st.style]}>{st.label}</span>
                <span class="shrink-0 text-right font-medium whitespace-nowrap tabular-nums sm:w-28">{formatPrice(o.total)}</span>
              </li>
            );
          })}
        </ul>
      )}
    </div>

    <div class:list={[card, 'lg:col-span-2']}>
      <div class="flex items-baseline justify-between">
        <p class={cardTitle}>Para reponer</p>
        <a href="/admin/inventario" class="text-sm font-semibold text-neutral-900 hover:underline">Inventario</a>
      </div>
      {lowStock.length === 0 ? (
        <p class="mt-4 text-sm text-neutral-500">Ningún producto por debajo del mínimo.</p>
      ) : (
        <ul class="mt-3 divide-y divide-neutral-100 text-sm">
          {lowStock.map((p) => (
            <li class="flex items-center gap-3 py-2">
              <img src={p.image_url} alt="" class="size-9 rounded-md object-cover" loading="lazy" />
              <a href={`/admin/productos/${p.id}`} class="min-w-0 flex-1 truncate hover:underline">{p.name}</a>
              <span class:list={['text-xs font-semibold tabular-nums', p.stock <= 0 ? 'text-rose-700' : 'text-amber-700']}>
                {p.stock <= 0 ? 'Sin stock' : <>{p.stock} / mín. {p.min_stock}</>}
              </span>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</AdminLayout>
