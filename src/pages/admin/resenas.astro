---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getPendingReviews, approveReview, deleteReview } from '../../lib/reviews';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('_action');
  const id = Number(form.get('id'));
  if (Number.isInteger(id)) {
    if (action === 'approve') await approveReview(id);
    if (action === 'delete') await deleteReview(id);
  }
  return Astro.redirect('/admin/resenas');
}

const pending = await getPendingReviews();
---

<AdminLayout title="Reseñas — NoteStore admin">
  <h1 class="text-2xl font-bold tracking-tight">Reseñas pendientes</h1>
  <p class="mt-1 text-sm text-neutral-500">Aprobá o eliminá las reseñas antes de que se publiquen en la tienda.</p>

  <div class="mt-8 overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-sm">
    {pending.length === 0 ? (
      <p class="p-10 text-center text-neutral-500">No hay reseñas pendientes.</p>
    ) : (
      <ul class="divide-y divide-neutral-100">
        {pending.map((r) => (
          <li class="p-5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div>
                <a href={`/productos/${r.product_slug}`} target="_blank" class="font-semibold hover:underline">
                  {r.product_name}
                </a>
                <span class="ml-2 text-xs text-neutral-400">por {r.user_name}</span>
              </div>
              <div class="flex items-center gap-1 text-amber-500">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span>{i < r.rating ? '★' : '☆'}</span>
                ))}
              </div>
            </div>
            {r.comment && <p class="mt-2 text-sm text-neutral-600">{r.comment}</p>}
            <div class="mt-3 flex gap-2">
              <form method="POST">
                <input type="hidden" name="_action" value="approve" />
                <input type="hidden" name="id" value={r.id} />
                <button type="submit" class="cursor-pointer rounded-lg bg-emerald-50 px-3 py-1.5 text-xs font-semibold text-emerald-700 hover:bg-emerald-100">
                  Aprobar
                </button>
              </form>
              <form method="POST" onsubmit="return confirm('¿Eliminar esta reseña?')">
                <input type="hidden" name="_action" value="delete" />
                <input type="hidden" name="id" value={r.id} />
                <button type="submit" class="cursor-pointer rounded-lg bg-rose-50 px-3 py-1.5 text-xs font-semibold text-rose-600 hover:bg-rose-100">
                  Eliminar
                </button>
              </form>
            </div>
          </li>
        ))}
      </ul>
    )}
  </div>
</AdminLayout>
