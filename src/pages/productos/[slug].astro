---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getDb, type Product } from '../../lib/db';
import { formatPrice } from '../../lib/util';
import { getProductImages, getProductVariants } from '../../lib/products';
import { getApprovedReviews, getProductRatingSummary, createReview } from '../../lib/reviews';
import { isWishlisted, getWishlistedIds } from '../../lib/wishlist';

const db = await getDb();
const { slug } = Astro.params;
const user = Astro.locals.user;

const res = await db.execute({
  sql: `SELECT p.*, c.name AS category_name, c.slug AS category_slug
        FROM products p LEFT JOIN categories c ON c.id = p.category_id
        WHERE p.slug = ?`,
  args: [slug ?? ''],
});
const product = res.rows[0] as unknown as Product | undefined;
if (!product) return Astro.redirect('/productos');

let reviewError = '';
if (Astro.request.method === 'POST' && user) {
  const form = await Astro.request.formData();
  if (form.get('_action') === 'review') {
    const rating = Number(form.get('rating'));
    const comment = String(form.get('comment') ?? '');
    const result = await createReview(product.id, user.id, rating, comment);
    if (result.error) reviewError = result.error;
    else return Astro.redirect(`/productos/${product.slug}?reseña=enviada`);
  }
}

const relatedRes = await db.execute({
  sql: `SELECT p.*, c.name AS category_name, c.slug AS category_slug
        FROM products p LEFT JOIN categories c ON c.id = p.category_id
        WHERE p.category_id = ? AND p.id != ? ORDER BY p.created_at DESC LIMIT 4`,
  args: [product.category_id ?? -1, product.id],
});
const related = relatedRes.rows as unknown as Product[];

const specs = [
  { label: 'Procesador', value: product.cpu },
  { label: 'Memoria RAM', value: product.ram },
  { label: 'Almacenamiento', value: product.storage },
  { label: 'Pantalla', value: product.screen },
].filter((s) => s.value);

const onSale = product.old_price != null && product.old_price > product.price;

const images = await getProductImages(product.id);
const variants = await getProductVariants(product.id);
const reviews = await getApprovedReviews(product.id);
const rating = await getProductRatingSummary(product.id);
const wishlisted = user ? await isWishlisted(user.id, product.id) : false;
const myReview = user ? reviews.find((r) => r.user_id === user.id) : undefined;
const relatedWishlistedIds = user ? await getWishlistedIds(user.id) : new Set<number>();

const cartPayload = JSON.stringify({
  id: product.id,
  name: product.name,
  price: product.price,
  image: product.image_url,
  slug: product.slug,
});

// Datos estructurados para que Google muestre precio y disponibilidad
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  image: product.image_url,
  description: product.description.slice(0, 300),
  ...(product.brand ? { brand: { '@type': 'Brand', name: product.brand } } : {}),
  offers: {
    '@type': 'Offer',
    url: new URL(`/productos/${product.slug}`, Astro.site ?? Astro.url.origin).href,
    priceCurrency: 'PYG',
    price: product.price,
    availability:
      product.stock > 0 ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
  },
});
---

<BaseLayout
  title={`${product.name} — NoteStore`}
  description={product.description.slice(0, 150)}
  image={product.image_url}
  ogType="product"
>
  <script is:inline type="application/ld+json" set:html={jsonLd} />
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
    <nav class="flex items-center gap-2 text-sm text-neutral-500">
      <a href="/" class="hover:text-neutral-900">Inicio</a>
      <span>/</span>
      <a href="/productos" class="hover:text-neutral-900">Notebooks</a>
      {product.category_name && (
        <>
          <span>/</span>
          <a href={`/categorias/${product.category_slug}`} class="hover:text-neutral-900">
            {product.category_name}
          </a>
        </>
      )}
    </nav>

    <div class="mt-8 grid gap-10 lg:grid-cols-2">
      <div>
        <div class="animate-fade-up relative overflow-hidden rounded-3xl border border-neutral-200 bg-white shadow-sm">
          <img id="main-image" src={product.image_url} alt={product.name} class="aspect-[4/3] w-full object-cover" />
          <button
            type="button"
            data-wishlist-toggle={product.id}
            class:list={[
              'wishlist-btn absolute top-4 right-4 flex size-10 cursor-pointer items-center justify-center rounded-full bg-white/90 text-neutral-500 shadow transition-colors hover:text-rose-500',
              { 'is-wishlisted': wishlisted },
            ]}
            aria-label="Agregar a favoritos"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
          </button>
        </div>
        {images.length > 0 && (
          <div class="mt-3 grid grid-cols-5 gap-2">
            <button type="button" class="thumb-btn overflow-hidden rounded-xl border-2 border-neutral-900" data-src={product.image_url}>
              <img src={product.image_url} alt="" class="aspect-square w-full object-cover" />
            </button>
            {images.map((img) => (
              <button type="button" class="thumb-btn overflow-hidden rounded-xl border-2 border-transparent" data-src={img.image_url}>
                <img src={img.image_url} alt="" class="aspect-square w-full object-cover" />
              </button>
            ))}
          </div>
        )}
      </div>

      <div class="animate-fade-up anim-delay-1 flex flex-col">
        <p class="text-sm font-semibold tracking-wide text-neutral-900 uppercase">{product.brand}</p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-balance sm:text-4xl">{product.name}</h1>

        {rating.count > 0 && (
          <div class="mt-2 flex items-center gap-1.5 text-sm">
            <span class="text-amber-500">{'★'.repeat(Math.round(rating.avg))}{'☆'.repeat(5 - Math.round(rating.avg))}</span>
            <span class="text-neutral-500">{rating.avg.toFixed(1)} ({rating.count} {rating.count === 1 ? 'reseña' : 'reseñas'})</span>
          </div>
        )}

        <div class="mt-5 flex items-end gap-3">
          <p id="price-display" class="text-4xl font-extrabold">{formatPrice(product.price)}</p>
          {onSale && (
            <>
              <p class="pb-1 text-lg text-neutral-400 line-through">{formatPrice(product.old_price!)}</p>
              <span class="mb-1.5 rounded-full bg-rose-100 px-2.5 py-0.5 text-xs font-bold text-rose-600">
                -{Math.round((1 - product.price / product.old_price!) * 100)}%
              </span>
            </>
          )}
        </div>
        <p class="mt-1 text-sm text-neutral-500">Hasta 12 cuotas sin interés</p>

        <p class="mt-6 leading-relaxed text-neutral-600">{product.description}</p>

        {specs.length > 0 && (
          <dl class="mt-8 grid grid-cols-2 gap-3">
            {specs.map((s) => (
              <div class="rounded-xl border border-neutral-200 bg-white p-4">
                <dt class="text-xs font-medium tracking-wide text-neutral-400 uppercase">{s.label}</dt>
                <dd class="mt-1 text-sm font-semibold">{s.value}</dd>
              </div>
            ))}
          </dl>
        )}

        {variants.length > 0 && (
          <div class="mt-8">
            <p class="mb-2 text-sm font-semibold text-neutral-700">Elegí una opción</p>
            <div id="variant-options" class="flex flex-wrap gap-2">
              {variants.map((v, i) => (
                <label
                  class="variant-opt cursor-pointer rounded-full border-2 border-neutral-200 px-4 py-2 text-sm font-medium transition-colors has-checked:border-neutral-900 has-checked:bg-neutral-900 has-checked:text-white"
                >
                  <input
                    type="radio"
                    name="variant"
                    value={v.id}
                    class="sr-only"
                    checked={i === 0}
                    data-delta={v.price_delta}
                    data-stock={v.stock}
                    data-label={`${v.name}: ${v.value}`}
                  />
                  {v.value} {v.stock <= 0 && '(sin stock)'}
                </label>
              ))}
            </div>
          </div>
        )}

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <button
            id="add-to-cart-btn"
            type="button"
            data-add-to-cart={cartPayload}
            disabled={product.stock <= 0 && variants.length === 0}
            class="flex cursor-pointer items-center gap-2 rounded-full bg-neutral-900 px-8 py-3.5 font-semibold text-white transition-all hover:scale-[1.02] hover:bg-neutral-700 disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:scale-100"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
            Agregar al carrito
          </button>
          <p id="stock-msg" class="text-sm font-medium text-emerald-600">
            {product.stock > 0 || variants.length > 0
              ? `✓ En stock${variants.length === 0 ? ` (${product.stock} ${product.stock === 1 ? 'unidad' : 'unidades'})` : ''}`
              : ''}
          </p>
          {product.stock <= 0 && variants.length === 0 && (
            <p class="rounded-full bg-neutral-100 px-6 py-3 font-semibold text-neutral-500">Sin stock por el momento</p>
          )}
        </div>
      </div>
    </div>

    <script is:inline define:vars={{ basePrice: product.price }}>
      const fmt = new Intl.NumberFormat('es-PY', { style: 'currency', currency: 'PYG', maximumFractionDigits: 0 });
      const btn = document.getElementById('add-to-cart-btn');
      const priceEl = document.getElementById('price-display');
      const stockMsg = document.getElementById('stock-msg');

      document.querySelectorAll('.thumb-btn').forEach((t) => {
        t.addEventListener('click', () => {
          document.getElementById('main-image').src = t.getAttribute('data-src');
          document.querySelectorAll('.thumb-btn').forEach((x) => x.classList.remove('border-neutral-900'));
          t.classList.add('border-neutral-900');
        });
      });

      const radios = document.querySelectorAll('input[name="variant"]');
      function syncVariant() {
        const checked = document.querySelector('input[name="variant"]:checked');
        if (!checked) return;
        const delta = Number(checked.dataset.delta || 0);
        const stock = Number(checked.dataset.stock || 0);
        const label = checked.dataset.label || '';
        const price = basePrice + delta;
        priceEl.textContent = fmt.format(price);
        const payload = JSON.parse(btn.getAttribute('data-add-to-cart'));
        payload.price = price;
        payload.variantId = Number(checked.value);
        payload.variantLabel = label;
        btn.setAttribute('data-add-to-cart', JSON.stringify(payload));
        btn.disabled = stock <= 0;
        stockMsg.textContent = stock > 0 ? `✓ En stock (${stock} ${stock === 1 ? 'unidad' : 'unidades'})` : 'Sin stock para esta opción';
      }
      radios.forEach((r) => r.addEventListener('change', syncVariant));
      if (radios.length > 0) syncVariant();
    </script>

    <section class="mt-20 max-w-2xl">
      <h2 class="text-2xl font-bold tracking-tight">Reseñas</h2>

      {user && !myReview && (
        <form method="POST" class="mt-6 rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm">
          <input type="hidden" name="_action" value="review" />
          {reviewError && <p class="mb-4 rounded-xl bg-rose-50 px-4 py-3 text-sm font-medium text-rose-600">{reviewError}</p>}
          <p class="text-sm font-semibold text-neutral-700">Tu calificación</p>
          <div class="mt-2 flex gap-1 text-2xl text-amber-500">
            {[1, 2, 3, 4, 5].map((n) => (
              <label class="cursor-pointer">
                <input type="radio" name="rating" value={n} class="peer sr-only" checked={n === 5} />
                <span class="peer-checked:hidden">☆</span>
                <span class="hidden peer-checked:inline">★</span>
              </label>
            ))}
          </div>
          <textarea
            name="comment"
            rows="3"
            class="mt-3 w-full rounded-xl border border-neutral-200 bg-white px-4 py-2.5 text-sm outline-none focus:border-neutral-500 focus:ring-2 focus:ring-neutral-200"
            placeholder="Contanos qué te pareció (opcional)"
          ></textarea>
          <button type="submit" class="mt-3 cursor-pointer rounded-xl bg-neutral-900 px-6 py-2.5 text-sm font-semibold text-white hover:bg-neutral-700">
            Enviar reseña
          </button>
          <p class="mt-2 text-xs text-neutral-400">Tu reseña se publica luego de ser revisada por el equipo.</p>
        </form>
      )}
      {myReview && (
        <p class="mt-4 rounded-xl bg-neutral-100 px-4 py-3 text-sm text-neutral-600">
          Ya enviaste una reseña para este producto{myReview.approved ? '' : ' (pendiente de aprobación)'}.
        </p>
      )}
      {!user && (
        <p class="mt-4 text-sm text-neutral-500">
          <a href={`/login?next=/productos/${product.slug}`} class="font-semibold text-neutral-900 hover:underline">Iniciá sesión</a> para dejar tu reseña.
        </p>
      )}

      {reviews.length === 0 ? (
        <p class="mt-8 text-sm text-neutral-500">Todavía no hay reseñas para este producto.</p>
      ) : (
        <ul class="mt-8 space-y-5">
          {reviews.map((r) => (
            <li class="border-b border-neutral-100 pb-5">
              <div class="flex items-center gap-2">
                <span class="text-amber-500">{'★'.repeat(r.rating)}{'☆'.repeat(5 - r.rating)}</span>
                <span class="text-sm font-semibold">{r.user_name}</span>
              </div>
              {r.comment && <p class="mt-1.5 text-sm text-neutral-600">{r.comment}</p>}
            </li>
          ))}
        </ul>
      )}
    </section>

    {related.length > 0 && (
      <section class="mt-20">
        <h2 class="text-2xl font-bold tracking-tight" data-reveal>También te puede interesar</h2>
        <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
          {related.map((p) => (
            <ProductCard product={p} wishlisted={relatedWishlistedIds.has(p.id)} />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
