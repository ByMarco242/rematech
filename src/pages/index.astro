---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import Price from '../components/Price.astro';
import { getDb, type Product, type Category } from '../lib/db';
import { formatPrice } from '../lib/util';
import { getWishlistedIds } from '../lib/wishlist';

const db = await getDb();
const wishlistedIds = Astro.locals.user ? await getWishlistedIds(Astro.locals.user.id) : new Set<number>();

const productSelect = `SELECT p.*, c.name AS category_name, c.slug AS category_slug
  FROM products p LEFT JOIN categories c ON c.id = p.category_id`;

const [latestRes, featuredRes, offersRes, categoriesRes, budgetRes] = await Promise.all([
  db.execute(`${productSelect} ORDER BY p.created_at DESC, p.id DESC LIMIT 4`),
  db.execute(`${productSelect} WHERE p.featured = 1 ORDER BY p.created_at DESC LIMIT 4`),
  db.execute(`${productSelect} WHERE p.old_price > p.price AND p.stock > 0
              ORDER BY (p.old_price - p.price) * 1.0 / p.old_price DESC LIMIT 4`),
  db.execute(
    `SELECT c.*, COUNT(p.id) AS product_count, MIN(p.price) AS min_price
     FROM categories c LEFT JOIN products p ON p.category_id = c.id
     GROUP BY c.id ORDER BY c.name`
  ),
  db.execute(
    `SELECT
       SUM(CASE WHEN price <= 5000000 THEN 1 ELSE 0 END) AS b1,
       SUM(CASE WHEN price > 5000000 AND price <= 10000000 THEN 1 ELSE 0 END) AS b2,
       SUM(CASE WHEN price > 10000000 AND price <= 15000000 THEN 1 ELSE 0 END) AS b3,
       SUM(CASE WHEN price > 15000000 THEN 1 ELSE 0 END) AS b4,
       (SELECT COUNT(*) FROM products WHERE old_price > price) AS offers
     FROM products`
  ),
]);

const latest = latestRes.rows as unknown as Product[];
const featured = featuredRes.rows as unknown as Product[];
const offers = offersRes.rows as unknown as Product[];
const heroProducts = featured.length > 0 ? featured : latest.slice(0, 3);
const categories = categoriesRes.rows as unknown as (Category & { product_count: number; min_price: number | null })[];
const b = budgetRes.rows[0] as unknown as Record<'b1' | 'b2' | 'b3' | 'b4' | 'offers', number | null>;

const budgets = [
  { label: 'Hasta 5 M', hint: 'Estudio y oficina', count: b.b1 ?? 0, href: '/productos?max=5000000&orden=precio-asc' },
  { label: '5 a 10 M', hint: 'Uso diario y multitarea', count: b.b2 ?? 0, href: '/productos?min=5000000&max=10000000' },
  { label: '10 a 15 M', hint: 'Gaming y edición', count: b.b3 ?? 0, href: '/productos?min=10000000&max=15000000' },
  { label: 'Más de 15 M', hint: 'Workstations y gama alta', count: b.b4 ?? 0, href: '/productos?min=15000000' },
];

function heroSpecs(p: Product) {
  return [
    ['Procesador', p.cpu],
    ['Placa de video', p.gpu],
    ['Memoria', p.ram],
    ['Almacenamiento', p.storage],
    ['Pantalla', p.screen],
  ].filter(([, v]) => v);
}
---

<BaseLayout>
  <!-- Equipo destacado -->
  {heroProducts.length > 0 && (
    <section class="border-b border-line" aria-labelledby="hero-title">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <div class="flex items-center justify-between border-b border-line py-3">
          <h1 id="hero-title" class="eyebrow text-fg-muted">Notebooks nuevas · Garantía oficial · Envío a todo el país</h1>
          <p class="eyebrow hidden text-fg-subtle sm:block">Destacados</p>
        </div>

        {heroProducts.map((p, i) => (
          <div
            id={`hero-panel-${i}`}
            role="tabpanel"
            aria-labelledby={`hero-tab-${i}`}
            hidden={i !== 0}
            class="grid gap-8 py-10 lg:grid-cols-12 lg:gap-10 lg:py-14"
            data-hero-panel
          >
            <div class="flex flex-col lg:col-span-5 lg:py-4">
              <p class="eyebrow text-accent">{p.category_name ?? p.brand}</p>
              <h2 class="font-display mt-3 text-5xl leading-[0.92] font-extrabold uppercase sm:text-6xl xl:text-7xl">
                {p.name}
              </h2>
              <p class="mt-4 font-mono text-sm text-fg-muted">
                {[p.cpu, p.gpu, p.ram, p.storage].filter(Boolean).join('  ·  ')}
              </p>

              <dl class="mt-8 grid grid-cols-2 border-t border-line">
                {heroSpecs(p).map(([k, v], j) => (
                  <div class:list={['border-b border-line py-3', j % 2 === 0 ? 'pr-4' : 'border-l pl-4']}>
                    <dt class="eyebrow text-fg-subtle">{k}</dt>
                    <dd class="mt-1 text-sm font-medium">{v}</dd>
                  </div>
                ))}
              </dl>

              <div class="mt-8">
                <Price price={p.price} oldPrice={p.old_price} size="lg" />
                <p class="mt-1 text-sm text-fg-muted">Hasta 12 cuotas sin interés</p>
              </div>
              <div class="mt-6 flex flex-wrap gap-2">
                <a href={`/productos/${p.slug}`} class="btn btn-primary px-6">Ver equipo</a>
                <button type="button" data-compare-toggle={p.id} aria-pressed="false" class="btn btn-secondary aria-pressed:border-accent aria-pressed:text-accent">
                  Comparar
                </button>
              </div>
            </div>

            <a href={`/productos/${p.slug}`} class="order-first block bg-surface lg:order-none lg:col-span-7" tabindex="-1" aria-hidden="true">
              <img
                src={p.image_url}
                alt=""
                width="1200"
                height="900"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'auto'}
                class="aspect-[4/3] size-full object-cover"
              />
            </a>
          </div>
        ))}

        {heroProducts.length > 1 && (
          <div role="tablist" aria-label="Equipos destacados" class="grid border-t border-line sm:grid-cols-2 lg:grid-cols-4" data-hero-tabs>
            {heroProducts.map((p, i) => (
              <button
                type="button"
                role="tab"
                id={`hero-tab-${i}`}
                aria-controls={`hero-panel-${i}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                class="relative cursor-pointer border-line px-0 py-4 text-left transition-colors not-first:border-t sm:px-4 sm:first:pl-0 sm:not-first:border-t-0 lg:not-first:border-l aria-selected:before:absolute aria-selected:before:inset-x-0 aria-selected:before:-top-px aria-selected:before:h-0.5 aria-selected:before:bg-accent sm:aria-selected:before:left-4 sm:first:aria-selected:before:left-0"
              >
                <span class="eyebrow text-fg-subtle">{String(i + 1).padStart(2, '0')}</span>
                <span class="mt-1 block truncate text-sm font-medium">{p.name}</span>
                <span class="mt-0.5 block font-mono text-xs text-fg-muted">{formatPrice(p.price)}</span>
              </button>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Por uso -->
  <section id="categorias" class="mx-auto max-w-7xl scroll-mt-20 px-4 pt-20 sm:px-6" aria-labelledby="uso-title">
    <div class="grid gap-2 lg:grid-cols-12">
      <h2 id="uso-title" class="font-display text-3xl font-extrabold uppercase sm:text-4xl lg:col-span-5">¿Para qué la vas a usar?</h2>
      <p class="text-fg-muted lg:col-span-5 lg:col-start-8 lg:self-end">
        Si no conocés de hardware, empezá por acá: agrupamos los equipos según el uso
        y te mostramos desde qué precio arrancan.
      </p>
    </div>
    {categories.length === 0 ? (
      <p class="mt-8 border border-dashed border-line-strong p-10 text-center text-fg-muted">
        Todavía no hay categorías cargadas.
      </p>
    ) : (
      <ul class="mt-10 grid grid-cols-2 border-t border-l border-line sm:grid-cols-3 lg:grid-cols-6">
        {categories.map((c, i) => (
          <li class="border-r border-b border-line">
            <a href={`/categorias/${c.slug}`} class="group flex h-full flex-col p-4 transition-colors hover:bg-surface sm:p-5">
              <span class="eyebrow text-fg-subtle group-hover:text-accent">{String(i + 1).padStart(2, '0')}</span>
              <span class="font-display mt-6 text-xl font-bold uppercase">{c.name}</span>
              <span class="mt-1 line-clamp-2 text-sm text-fg-muted">{c.description}</span>
              <span class="mt-auto pt-5 font-mono text-xs text-fg-muted">
                {c.product_count} {c.product_count === 1 ? 'modelo' : 'modelos'}
                {c.min_price != null && <><br />desde {formatPrice(c.min_price)}</>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>

  <!-- Ofertas -->
  {offers.length > 0 && (
    <section class="mx-auto max-w-7xl px-4 pt-20 sm:px-6" aria-labelledby="ofertas-title">
      <div class="flex items-end justify-between gap-4 border-b border-line pb-4">
        <div>
          <h2 id="ofertas-title" class="font-display text-3xl font-extrabold uppercase sm:text-4xl">Ofertas</h2>
          <p class="mt-1 text-sm text-fg-muted">{b.offers} equipos con precio rebajado</p>
        </div>
        <a href="/productos?oferta=1" class="text-sm font-medium text-fg-muted hover:text-fg">Ver todas →</a>
      </div>
      <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {offers.map((p) => (
          <ProductCard product={p} wishlisted={wishlistedIds.has(p.id)} />
        ))}
      </div>
    </section>
  )}

  <!-- Por presupuesto -->
  <section class="mx-auto max-w-7xl px-4 pt-20 sm:px-6" aria-labelledby="presupuesto-title">
    <div class="grid gap-8 border border-line bg-surface p-6 sm:p-8 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2 id="presupuesto-title" class="font-display text-3xl font-extrabold uppercase">Por presupuesto</h2>
        <p class="mt-2 text-sm text-fg-muted">Precios en guaraníes. Hasta 12 cuotas sin interés con tarjeta.</p>
      </div>
      <ul class="grid grid-cols-2 gap-px bg-line lg:col-span-8 lg:grid-cols-4">
        {budgets.map((r) => (
          <li class="bg-surface">
            <a href={r.href} class="group flex h-full flex-col bg-surface p-4 transition-colors hover:bg-surface-2">
              <span class="font-mono text-xs text-fg-subtle">Gs.</span>
              <span class="font-display text-2xl font-bold uppercase group-hover:text-accent">{r.label}</span>
              <span class="mt-1 text-sm text-fg-muted">{r.hint}</span>
              <span class="mt-4 font-mono text-xs text-fg-muted">{r.count} {r.count === 1 ? 'modelo' : 'modelos'}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Recién llegadas -->
  <section id="novedades" class="mx-auto max-w-7xl scroll-mt-20 px-4 pt-20 sm:px-6" aria-labelledby="nuevos-title">
    <div class="flex items-end justify-between gap-4 border-b border-line pb-4">
      <h2 id="nuevos-title" class="font-display text-3xl font-extrabold uppercase sm:text-4xl">Recién llegadas</h2>
      <a href="/productos" class="text-sm font-medium text-fg-muted hover:text-fg">Catálogo completo →</a>
    </div>
    {latest.length === 0 ? (
      <p class="mt-6 border border-dashed border-line-strong p-10 text-center text-fg-muted">Todavía no hay productos cargados.</p>
    ) : (
      <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {latest.map((p) => (
          <ProductCard product={p} wishlisted={wishlistedIds.has(p.id)} />
        ))}
      </div>
    )}
  </section>

  <script is:inline>
    (() => {
      const tablist = document.querySelector('[data-hero-tabs]');
      if (!tablist) return;
      const tabs = [...tablist.querySelectorAll('[role="tab"]')];
      const panels = [...document.querySelectorAll('[data-hero-panel]')];

      const select = (i, focus) => {
        tabs.forEach((t, j) => {
          t.setAttribute('aria-selected', String(i === j));
          t.tabIndex = i === j ? 0 : -1;
        });
        panels.forEach((p, j) => (p.hidden = i !== j));
        if (focus) tabs[i].focus();
      };

      tabs.forEach((t, i) => t.addEventListener('click', () => select(i, false)));
      tablist.addEventListener('keydown', (e) => {
        const i = tabs.indexOf(document.activeElement);
        if (i < 0) return;
        if (e.key === 'ArrowRight') select((i + 1) % tabs.length, true);
        else if (e.key === 'ArrowLeft') select((i - 1 + tabs.length) % tabs.length, true);
        else return;
        e.preventDefault();
      });
    })();
  </script>
</BaseLayout>
