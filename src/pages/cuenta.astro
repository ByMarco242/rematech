---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDb, type Order, type OrderItem } from '../lib/db';
import { formatPrice } from '../lib/util';
import { getWishlist } from '../lib/wishlist';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login?next=/cuenta');

const db = await getDb();
let saved = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const name = String(form.get('name') ?? '').trim().slice(0, 80);
  const phone = String(form.get('phone') ?? '').trim().slice(0, 30);
  const address = String(form.get('address') ?? '').trim().slice(0, 200);
  if (name) {
    await db.execute({
      sql: 'UPDATE users SET name = ?, phone = ?, address = ? WHERE id = ?',
      args: [name, phone, address, user.id],
    });
    saved = true;
  }
}

const meRes = await db.execute({
  sql: 'SELECT name, email, phone, address FROM users WHERE id = ?',
  args: [user.id],
});
const me = meRes.rows[0];

const ordersRes = await db.execute({
  sql: 'SELECT * FROM orders WHERE user_id = ? ORDER BY id DESC LIMIT 50',
  args: [user.id],
});
const orders = ordersRes.rows as unknown as Order[];

let itemsByOrder = new Map<number, OrderItem[]>();
if (orders.length > 0) {
  const placeholders = orders.map(() => '?').join(',');
  const itemsRes = await db.execute({
    sql: `SELECT * FROM order_items WHERE order_id IN (${placeholders}) ORDER BY id`,
    args: orders.map((o) => o.id),
  });
  for (const row of itemsRes.rows as unknown as OrderItem[]) {
    const list = itemsByOrder.get(row.order_id) ?? [];
    list.push(row);
    itemsByOrder.set(row.order_id, list);
  }
}

const statusInfo: Record<string, { style: string; label: string }> = {
  pendiente: { style: 'border border-warn/40 text-warn', label: 'Pendiente de confirmación' },
  aprobado: { style: 'border border-ok/40 text-ok', label: 'Confirmado' },
  enviado: { style: 'border border-sky-400/40 text-sky-400', label: 'Enviado' },
  entregado: { style: 'border border-ok/40 text-ok', label: 'Entregado' },
  cancelado: { style: 'border border-line-strong text-fg-muted', label: 'Cancelado' },
  rechazado: { style: 'border border-danger/40 text-danger', label: 'Rechazado' },
};

const dateFmt = new Intl.DateTimeFormat('es-PY', {
  dateStyle: 'short',
  timeStyle: 'short',
  timeZone: 'America/Asuncion',
});
function formatDate(sqlDate: string): string {
  return dateFmt.format(new Date(sqlDate.replace(' ', 'T') + 'Z'));
}

const input =
  'field';

const favorites = await getWishlist(user.id);
---

<BaseLayout title="Mi cuenta — NoteStore">
  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
    <h1 class="font-display uppercase text-3xl font-extrabold">Mi cuenta</h1>

    <div class="mt-8 grid gap-6 lg:grid-cols-3">
      <div>
        <div class="border border-line bg-surface p-6">
          <h2 class="font-bold">Mis datos</h2>
          {saved && (
            <p class="mt-4 border border-ok/40 px-4 py-3 text-sm font-medium text-ok">
              Datos actualizados ✓
            </p>
          )}
          <form method="POST" class="mt-4 space-y-4">
            <div>
              <label for="c-name" class="mb-1.5 block text-sm font-medium text-fg-muted">Nombre</label>
              <input id="c-name" name="name" required value={String(me?.name ?? '')} class={input} />
            </div>
            <div>
              <label class="mb-1.5 block text-sm font-medium text-fg-muted">Email</label>
              <input value={String(me?.email ?? '')} disabled class:list={[input, 'bg-surface-2 text-fg-subtle']} />
            </div>
            <div>
              <label for="c-phone" class="mb-1.5 block text-sm font-medium text-fg-muted">Teléfono</label>
              <input id="c-phone" name="phone" value={String(me?.phone ?? '')} class={input} placeholder="+595 9xx xxx xxx" />
              <p class="mt-1 text-xs text-fg-subtle">Lo usamos para coordinar la entrega de tus pedidos.</p>
            </div>
            <div>
              <label for="c-address" class="mb-1.5 block text-sm font-medium text-fg-muted">Dirección</label>
              <textarea id="c-address" name="address" rows="2" class={input} placeholder="Calle, número, ciudad">{String(me?.address ?? '')}</textarea>
            </div>
            <button
              type="submit"
              class="btn btn-primary w-full"
            >
              Guardar
            </button>
          </form>
        </div>

        {favorites.length > 0 && (
          <div class="mt-6 border border-line bg-surface p-6">
            <h2 class="font-bold">Mis favoritos</h2>
            <ul class="mt-4 space-y-3">
              {favorites.map((p) => (
                <li>
                  <a href={`/productos/${p.slug}`} class="flex items-center gap-3 hover:opacity-80">
                    <img src={p.image_url} alt="" class="size-12 shrink-0 object-cover" />
                    <div class="min-w-0">
                      <p class="truncate text-sm font-medium">{p.name}</p>
                      <p class="text-xs text-fg-muted">{formatPrice(p.price)}</p>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>

      <div class="lg:col-span-2">
        <h2 class="font-bold">Mis pedidos</h2>
        {orders.length === 0 ? (
          <div class="mt-4 border border-dashed border-line-strong p-12 text-center">
            <p class="font-semibold text-fg-muted">Todavía no hiciste ningún pedido</p>
            <a href="/productos" class="btn btn-primary mt-4 inline-block">
              Ver notebooks
            </a>
          </div>
        ) : (
          <div class="mt-4 space-y-4">
            {orders.map((o) => {
              const info = statusInfo[o.status] ?? statusInfo.pendiente;
              return (
                <article class="border border-line bg-surface p-5">
                  <header class="flex flex-wrap items-center gap-x-4 gap-y-2">
                    <p class="font-bold">Pedido #{o.id}</p>
                    <span class:list={['rounded-md px-2.5 py-0.5 text-xs font-semibold', info.style]}>
                      {info.label}
                    </span>
                    <p class="text-sm text-fg-muted">{formatDate(o.created_at)}</p>
                    <p class="ml-auto font-bold">{formatPrice(o.total)}</p>
                  </header>
                  {o.tracking_code && (
                    <p class="mt-2 text-sm text-fg-muted">
                      Seguimiento: <span class="font-mono font-semibold">{o.tracking_code}</span>
                    </p>
                  )}
                  {(o.discount > 0 || o.shipping_cost > 0) && (
                    <div class="mt-2 space-y-0.5 text-xs text-fg-muted">
                      {o.discount > 0 && <p>Descuento ({o.coupon_code}): -{formatPrice(o.discount)}</p>}
                      {o.shipping_cost > 0 && <p>Envío ({o.shipping_zone}): {formatPrice(o.shipping_cost)}</p>}
                    </div>
                  )}
                  <ul class="mt-3 divide-y divide-line border-t border-line">
                    {(itemsByOrder.get(o.id) ?? []).map((item) => (
                      <li class="flex items-center justify-between gap-3 py-2 text-sm">
                        <span>
                          {item.product_name}
                          {item.variant_label && <span class="text-fg-subtle"> ({item.variant_label})</span>}
                          <span class="ml-1 rounded-md bg-surface-2 px-1.5 py-0.5 text-xs font-semibold text-fg-muted">
                            x{item.qty}
                          </span>
                        </span>
                        <span class="whitespace-nowrap text-fg-muted">{formatPrice(item.price * item.qty)}</span>
                      </li>
                    ))}
                  </ul>
                </article>
              );
            })}
          </div>
        )}
      </div>
    </div>
  </div>
</BaseLayout>
