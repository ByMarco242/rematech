---
const year = new Date().getFullYear();

const terms = [
  ['Envío gratis', 'Desde Gs. 3.000.000. Entrega en 24/48 h en todo el país.'],
  ['Garantía oficial', 'Todos los equipos con garantía oficial de fábrica.'],
  ['Hasta 12 cuotas', 'Con tarjeta, sin interés.'],
  ['Asesoramiento', 'Consultá por WhatsApp antes de comprar.'],
];
---

<footer class="mt-24 border-t border-line bg-surface text-fg-muted">
  <dl class="mx-auto grid max-w-7xl grid-cols-2 gap-px border-b border-line px-4 sm:px-6 lg:grid-cols-4">
    {terms.map(([title, desc]) => (
      <div class="py-6 pr-4">
        <dt class="text-sm font-semibold text-fg">{title}</dt>
        <dd class="mt-1 text-sm">{desc}</dd>
      </div>
    ))}
  </dl>
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-[2fr_1fr_1fr_1fr]">
    <div>
      <p class="flex items-center gap-2">
        <span class="size-3 bg-accent" aria-hidden="true"></span>
        <span class="font-display text-lg font-extrabold tracking-wide text-fg uppercase">NoteStore</span>
      </p>
      <p class="mt-3 max-w-xs text-sm leading-relaxed">
        Notebooks nuevas para gaming, trabajo y estudio. Pedidos y consultas por WhatsApp.
      </p>
    </div>
    <nav aria-labelledby="f-tienda">
      <h2 id="f-tienda" class="eyebrow text-fg-subtle">Tienda</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/productos" class="hover:text-fg">Todas las notebooks</a></li>
        <li><a href="/productos?oferta=1" class="hover:text-fg">Ofertas</a></li>
        <li><a href="/comparar" class="hover:text-fg">Comparar</a></li>
      </ul>
    </nav>
    <nav aria-labelledby="f-cuenta">
      <h2 id="f-cuenta" class="eyebrow text-fg-subtle">Cuenta</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/cuenta" class="hover:text-fg">Mi cuenta</a></li>
        <li><a href="/carrito" class="hover:text-fg">Carrito</a></li>
        <li><a href="/registro" class="hover:text-fg">Crear cuenta</a></li>
      </ul>
    </nav>
    <nav aria-labelledby="f-ayuda">
      <h2 id="f-ayuda" class="eyebrow text-fg-subtle">Ayuda</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/contacto" class="hover:text-fg">Contacto</a></li>
        <li><a href="/recuperar" class="hover:text-fg">Recuperar contraseña</a></li>
      </ul>
    </nav>
  </div>
  <div class="border-t border-line">
    <p class="mx-auto max-w-7xl px-4 py-5 font-mono text-xs text-fg-subtle sm:px-6">© {year} NoteStore</p>
  </div>
</footer>
