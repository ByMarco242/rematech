---
import type { Product } from '../lib/db';
import { stockLevel, stockLabel } from '../lib/specs';
import Price from './Price.astro';

interface Props {
  product: Product;
  wishlisted?: boolean;
  /** Carga la imagen de inmediato (productos visibles sin scroll) */
  eager?: boolean;
}

const { product, wishlisted = false, eager = false } = Astro.props;

const cartPayload = JSON.stringify({
  id: product.id,
  name: product.name,
  price: product.price,
  image: product.image_url,
  slug: product.slug,
});

const specs = [
  ['CPU', product.cpu],
  ['GPU', product.gpu],
  ['RAM', product.ram],
  ['SSD', product.storage],
  ['Pantalla', product.screen],
].filter(([, v]) => v);

const level = stockLevel(product.stock, product.min_stock);
const stockColor = { in: 'bg-ok', low: 'bg-warn', out: 'bg-fg-subtle' }[level];
---

<article class="group relative flex flex-col border border-line bg-surface transition-colors hover:border-line-strong">
  <a href={`/productos/${product.slug}`} class="block aspect-[4/3] overflow-hidden bg-surface-2" tabindex="-1" aria-hidden="true">
    <img
      src={product.image_url}
      alt=""
      width="600"
      height="450"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class:list={['size-full object-cover transition-opacity duration-200 group-hover:opacity-90', { 'opacity-40 grayscale': level === 'out' }]}
    />
  </a>

  <button
    type="button"
    data-wishlist-toggle={product.id}
    class:list={[
      'wishlist-btn absolute top-2 right-2 flex size-8 cursor-pointer items-center justify-center bg-bg/80 text-fg-muted transition-colors hover:text-fg',
      { 'is-wishlisted': wishlisted },
    ]}
    aria-label={`Guardar ${product.name} en favoritos`}
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
  </button>

  <div class="flex flex-1 flex-col border-t border-line p-4">
    <p class="eyebrow text-fg-subtle">{product.brand}</p>
    <h3 class="mt-1 leading-snug font-semibold">
      <a href={`/productos/${product.slug}`} class="hover:text-accent">{product.name}</a>
    </h3>

    {specs.length > 0 && (
      <dl class="mt-3 space-y-1 font-mono text-xs">
        {specs.map(([k, v]) => (
          <div class="grid grid-cols-[4.5rem_1fr] gap-2">
            <dt class="text-fg-subtle">{k}</dt>
            <dd class="truncate text-fg-muted" title={v}>{v}</dd>
          </div>
        ))}
      </dl>
    )}

    <div class="mt-auto pt-4">
      <Price price={product.price} oldPrice={product.old_price} />
      <p class="mt-1 flex items-center gap-1.5 text-xs text-fg-muted">
        <span class:list={['size-1.5', stockColor]} aria-hidden="true"></span>
        {stockLabel[level]}
      </p>
    </div>

    <div class="mt-4 flex gap-2">
      <button
        type="button"
        data-add-to-cart={cartPayload}
        disabled={level === 'out'}
        class="btn btn-secondary flex-1 py-2 group-hover:border-fg-muted"
        aria-label={`Agregar ${product.name} al carrito`}
      >
        Agregar
      </button>
      <button
        type="button"
        data-compare-toggle={product.id}
        aria-pressed="false"
        class="btn btn-ghost border border-transparent px-2.5 py-2 text-xs aria-pressed:border-accent aria-pressed:text-accent"
        aria-label={`Comparar ${product.name}`}
        title="Comparar"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true"><path d="M8 3 4 7l4 4"/><path d="M4 7h16"/><path d="m16 21 4-4-4-4"/><path d="M20 17H4"/></svg>
        <span class="hidden xl:inline">Comparar</span>
      </button>
    </div>
  </div>
</article>
