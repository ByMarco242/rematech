---
import { getDb } from '../lib/db';

const user = Astro.locals.user;
const path = Astro.url.pathname;
const q = path === '/productos' ? (Astro.url.searchParams.get('q') ?? '') : '';

const db = await getDb();
const categoriesRes = await db.execute(
  `SELECT c.name, c.slug, COUNT(p.id) AS n
   FROM categories c LEFT JOIN products p ON p.category_id = c.id
   GROUP BY c.id ORDER BY c.name`
);
const categories = categoriesRes.rows as unknown as { name: string; slug: string; n: number }[];

const budgets = [
  { label: 'Hasta Gs. 5.000.000', href: '/productos?max=5000000' },
  { label: 'Gs. 5 a 10 millones', href: '/productos?min=5000000&max=10000000' },
  { label: 'Gs. 10 a 15 millones', href: '/productos?min=10000000&max=15000000' },
  { label: 'Más de Gs. 15 millones', href: '/productos?min=15000000' },
];

const isCatalog = path.startsWith('/productos') || path.startsWith('/categorias');
const isOffers = path === '/productos' && Astro.url.searchParams.get('oferta') === '1';

const linkBase = 'relative flex h-full items-center text-sm font-medium transition-colors';
const linkState = (active: boolean) =>
  active
    ? 'text-fg after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:bg-accent'
    : 'text-fg-muted hover:text-fg';
---

<header class="sticky top-0 z-50 border-b border-line bg-bg/95 backdrop-blur-sm">
  <div class="mx-auto flex h-14 max-w-7xl items-center gap-6 px-4 sm:px-6">
    <a href="/" class="flex shrink-0 items-center gap-2" aria-label="NoteStore, inicio">
      <span class="size-3 bg-accent" aria-hidden="true"></span>
      <span class="font-display text-lg font-extrabold tracking-wide uppercase">NoteStore</span>
    </a>

    <nav class="hidden h-full items-stretch gap-6 lg:flex" aria-label="Principal">
      <div class="group relative flex" data-dropdown>
        <button
          type="button"
          class:list={[linkBase, linkState(isCatalog && !isOffers), 'cursor-pointer gap-1']}
          aria-expanded="false"
          aria-controls="menu-notebooks"
          data-dropdown-trigger
        >
          Notebooks
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-3.5 transition-transform group-data-open:rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div
          id="menu-notebooks"
          class="invisible absolute top-full left-0 grid w-[34rem] grid-cols-[1.3fr_1fr] border border-line bg-surface opacity-0 transition-[opacity,visibility] duration-150 group-data-open:visible group-data-open:opacity-100"
        >
          <div class="border-r border-line p-2">
            <p class="eyebrow px-3 pt-2 pb-1 text-fg-subtle">Por uso</p>
            <ul>
              {categories.map((c) => (
                <li>
                  <a href={`/categorias/${c.slug}`} class="flex items-center justify-between px-3 py-2 text-sm text-fg-muted hover:bg-surface-2 hover:text-fg">
                    {c.name}
                    <span class="font-mono text-xs text-fg-subtle">{c.n}</span>
                  </a>
                </li>
              ))}
            </ul>
            <a href="/productos" class="mt-1 flex border-t border-line px-3 pt-3 pb-2 text-sm font-medium text-fg hover:text-accent">
              Ver todas las notebooks →
            </a>
          </div>
          <div class="p-2">
            <p class="eyebrow px-3 pt-2 pb-1 text-fg-subtle">Por presupuesto</p>
            <ul>
              {budgets.map((b) => (
                <li>
                  <a href={b.href} class="block px-3 py-2 text-sm text-fg-muted hover:bg-surface-2 hover:text-fg">{b.label}</a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
      <a href="/productos?oferta=1" class:list={[linkBase, linkState(isOffers)]}>Ofertas</a>
      <a href="/comparar" class:list={[linkBase, linkState(path === '/comparar')]}>Comparar</a>
      <a href="/contacto" class:list={[linkBase, linkState(path === '/contacto')]}>Contacto</a>
    </nav>

    <form action="/productos" method="GET" role="search" class="relative ml-auto hidden w-full max-w-xs md:block">
      <label for="header-search" class="sr-only">Buscar notebooks</label>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-fg-subtle" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input id="header-search" type="search" name="q" value={q} placeholder="Buscar modelo, marca o procesador" class="field py-2 pl-9" />
    </form>

    <div class="ml-auto flex items-center gap-1 md:ml-0">
      <div class="hidden items-center gap-4 lg:flex">
        {user ? (
          <>
            {user.is_staff && <a href="/admin" class="text-sm text-fg-muted hover:text-fg">Panel</a>}
            <a href="/cuenta" class:list={['text-sm hover:text-fg', path === '/cuenta' ? 'text-fg' : 'text-fg-muted']}>
              {user.name.split(' ')[0]}
            </a>
            <form method="POST" action="/api/logout">
              <button type="submit" class="cursor-pointer text-sm text-fg-muted hover:text-fg">Salir</button>
            </form>
          </>
        ) : (
          <a href="/login" class="text-sm text-fg-muted hover:text-fg">Ingresar</a>
        )}
      </div>

      <button
        type="button"
        class="flex size-9 cursor-pointer items-center justify-center text-fg-muted hover:text-fg md:hidden"
        aria-label="Buscar"
        aria-controls="mobile-menu"
        data-open-dialog="mobile-menu"
        data-focus="mobile-search"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-5" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </button>

      <a
        href="/carrito"
        class="ml-1 flex h-9 items-center md:ml-3 gap-2 border border-line-strong px-3 text-sm font-medium transition-colors hover:border-fg-muted"
        aria-label="Carrito"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
        <span class="hidden sm:inline">Carrito</span>
        <span
          data-cart-badge
          class="hidden min-w-5 items-center justify-center bg-accent px-1 font-mono text-[11px] leading-5 font-medium text-on-accent"
        ></span>
      </a>

      <button
        type="button"
        class="flex size-9 cursor-pointer items-center justify-center text-fg-muted hover:text-fg lg:hidden"
        aria-label="Abrir menú"
        aria-controls="mobile-menu"
        data-open-dialog="mobile-menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-5" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
</header>

<dialog id="mobile-menu" class="drawer drawer-right" aria-label="Menú">
  <div class="flex h-full flex-col">
    <div class="flex h-14 items-center justify-between border-b border-line px-4">
      <span class="eyebrow text-fg-subtle">Menú</span>
      <button type="button" class="flex size-9 cursor-pointer items-center justify-center text-fg-muted hover:text-fg" aria-label="Cerrar menú" data-close-dialog>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-5" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>
    <div class="flex-1 overflow-y-auto">
      <form action="/productos" method="GET" role="search" class="border-b border-line p-4">
        <label for="mobile-search" class="sr-only">Buscar notebooks</label>
        <input id="mobile-search" type="search" name="q" value={q} placeholder="Buscar modelo, marca o procesador" class="field" />
      </form>
      <nav aria-label="Menú móvil" class="p-2">
        <a href="/productos" class="flex px-3 py-2.5 font-medium">Todas las notebooks</a>
        <a href="/productos?oferta=1" class="flex px-3 py-2.5 font-medium">Ofertas</a>
        <a href="/comparar" class="flex px-3 py-2.5 font-medium">Comparar</a>
        <a href="/contacto" class="flex px-3 py-2.5 font-medium">Contacto</a>
        <p class="eyebrow mt-4 px-3 pb-1 text-fg-subtle">Por uso</p>
        {categories.map((c) => (
          <a href={`/categorias/${c.slug}`} class="flex items-center justify-between px-3 py-2 text-fg-muted">
            {c.name}<span class="font-mono text-xs text-fg-subtle">{c.n}</span>
          </a>
        ))}
        <p class="eyebrow mt-4 px-3 pb-1 text-fg-subtle">Por presupuesto</p>
        {budgets.map((b) => (
          <a href={b.href} class="flex px-3 py-2 text-fg-muted">{b.label}</a>
        ))}
      </nav>
    </div>
    <div class="border-t border-line p-4">
      {user ? (
        <div class="flex items-center gap-4 text-sm">
          <a href="/cuenta" class="font-medium">Mi cuenta</a>
          {user.is_staff && <a href="/admin" class="text-fg-muted">Panel</a>}
          <form method="POST" action="/api/logout" class="ml-auto">
            <button type="submit" class="cursor-pointer text-fg-muted">Salir</button>
          </form>
        </div>
      ) : (
        <div class="grid grid-cols-2 gap-2">
          <a href="/login" class="btn btn-secondary">Ingresar</a>
          <a href="/registro" class="btn btn-primary">Crear cuenta</a>
        </div>
      )}
    </div>
  </div>
</dialog>

<script is:inline>
  (() => {
    // Dropdowns del header: click/teclado y hover en desktop
    document.querySelectorAll('[data-dropdown]').forEach((wrap) => {
      const trigger = wrap.querySelector('[data-dropdown-trigger]');
      let hoverTimer;
      const set = (open) => {
        wrap.toggleAttribute('data-open', open);
        trigger.setAttribute('aria-expanded', String(open));
      };
      trigger.addEventListener('click', () => set(!wrap.hasAttribute('data-open')));
      wrap.addEventListener('mouseenter', () => { clearTimeout(hoverTimer); set(true); });
      wrap.addEventListener('mouseleave', () => { hoverTimer = setTimeout(() => set(false), 120); });
      wrap.addEventListener('focusout', (e) => { if (!wrap.contains(e.relatedTarget)) set(false); });
      wrap.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') { set(false); trigger.focus(); }
      });
      document.addEventListener('click', (e) => { if (!wrap.contains(e.target)) set(false); });
    });

    // Drawers con <dialog>: abrir, cerrar y cerrar al tocar el fondo
    document.addEventListener('click', (e) => {
      const opener = e.target.closest('[data-open-dialog]');
      if (opener) {
        document.getElementById(opener.dataset.openDialog)?.showModal();
        if (opener.dataset.focus) document.getElementById(opener.dataset.focus)?.focus();
        return;
      }
      if (e.target.closest('[data-close-dialog]')) {
        e.target.closest('dialog')?.close();
        return;
      }
      if (e.target instanceof HTMLDialogElement && e.target.classList.contains('drawer')) e.target.close();
    });
  })();
</script>
