---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Imagen para vista previa al compartir (Open Graph); URL absoluta o relativa */
  image?: string;
  /** Tipo Open Graph: 'website' (default) o 'product' */
  ogType?: string;
}

const {
  title = 'NoteStore — Tienda de Notebooks',
  description = 'Las mejores notebooks del mercado: gaming, ultrabooks, empresariales y más. Envíos a todo el país.',
  image,
  ogType = 'website',
} = Astro.props;

// En Vercel Astro.url.origin resuelve a localhost: el dominio real viene de `site`
const origin = Astro.site?.origin ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname, origin).href;
const ogImage = image ? new URL(image, origin).href : null;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="NoteStore" />
    <meta property="og:locale" content="es_PY" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='%230b0b0c'/><rect x='8' y='8' width='16' height='16' fill='%23ff4d00'/></svg>" />
    <meta name="theme-color" content="#0b0b0c" />
    <meta name="color-scheme" content="dark" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..800&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="theme-dark min-h-screen bg-bg text-fg antialiased">
    <a href="#contenido" class="sr-only z-100 bg-accent px-4 py-2 font-semibold text-on-accent focus:not-sr-only focus:fixed focus:top-2 focus:left-2">
      Saltar al contenido
    </a>
    <Navbar />

    <script is:inline>
      window.NoteStoreCart = {
        get() {
          try {
            return JSON.parse(localStorage.getItem('cart') || '[]');
          } catch {
            return [];
          }
        },
        save(items) {
          localStorage.setItem('cart', JSON.stringify(items));
          this.updateBadge();
          const badge = document.querySelector('[data-cart-badge]');
          if (badge && !badge.classList.contains('hidden')) {
            badge.classList.remove('badge-pop');
            void badge.offsetWidth;
            badge.classList.add('badge-pop');
          }
        },
        add(product) {
          const items = this.get();
          const found = items.find(
            (i) => i.id === product.id && (i.variantId ?? null) === (product.variantId ?? null)
          );
          if (found) found.qty += 1;
          else items.push({ ...product, qty: 1 });
          this.save(items);
        },
        remove(id, variantId) {
          this.save(
            this.get().filter((i) => !(i.id === id && (i.variantId ?? null) === (variantId ?? null)))
          );
        },
        setQty(id, qty, variantId) {
          const items = this.get();
          const found = items.find(
            (i) => i.id === id && (i.variantId ?? null) === (variantId ?? null)
          );
          if (!found) return;
          found.qty = Math.max(1, qty);
          this.save(items);
        },
        count() {
          return this.get().reduce((acc, i) => acc + i.qty, 0);
        },
        updateBadge() {
          const badge = document.querySelector('[data-cart-badge]');
          if (!badge) return;
          const n = this.count();
          badge.textContent = n > 99 ? '99+' : String(n);
          badge.classList.toggle('hidden', n === 0);
          badge.classList.toggle('flex', n > 0);
        },
      };

      let toastTimer;
      window.showToast = (msg) => {
        const el = document.getElementById('toast');
        if (!el) return;
        el.textContent = msg;
        el.classList.remove('opacity-0', 'translate-y-20');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
          el.classList.add('opacity-0', 'translate-y-20');
        }, 2200);
      };

      document.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-add-to-cart]');
        if (!btn) return;
        e.preventDefault();
        const product = JSON.parse(btn.getAttribute('data-add-to-cart'));
        window.NoteStoreCart.add(product);
        btn.classList.remove('btn-pop');
        void btn.offsetWidth;
        btn.classList.add('btn-pop');
        window.showToast('Agregado al carrito');
      });

      document.addEventListener('click', async (e) => {
        const btn = e.target.closest('[data-wishlist-toggle]');
        if (!btn) return;
        e.preventDefault();
        const productId = Number(btn.getAttribute('data-wishlist-toggle'));
        btn.disabled = true;
        try {
          const res = await fetch('/api/wishlist', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ productId }),
          });
          if (res.status === 401) {
            window.location.href = `/login?next=${encodeURIComponent(window.location.pathname)}`;
            return;
          }
          const data = await res.json();
          btn.classList.toggle('is-wishlisted', Boolean(data.wishlisted));
          window.showToast(data.wishlisted ? 'Agregado a favoritos' : 'Quitado de favoritos');
        } catch {
          window.showToast('No se pudo actualizar favoritos.');
        } finally {
          btn.disabled = false;
        }
      });

      window.NoteStoreCart.updateBadge();

      // Comparador: hasta 4 productos, guardados en localStorage
      window.NoteStoreCompare = {
        max: 4,
        get() {
          try {
            return JSON.parse(localStorage.getItem('compare') || '[]').map(Number).filter(Boolean);
          } catch {
            return [];
          }
        },
        save(ids) {
          try {
            localStorage.setItem('compare', JSON.stringify(ids));
          } catch {}
          this.sync();
        },
        toggle(id) {
          const ids = this.get();
          if (ids.includes(id)) {
            this.save(ids.filter((x) => x !== id));
            return false;
          }
          if (ids.length >= this.max) {
            window.showToast(`Podés comparar hasta ${this.max} productos.`);
            return false;
          }
          this.save([...ids, id]);
          return true;
        },
        sync() {
          const ids = this.get();
          document.querySelectorAll('[data-compare-toggle]').forEach((btn) => {
            btn.setAttribute('aria-pressed', String(ids.includes(Number(btn.dataset.compareToggle))));
          });
          const bar = document.getElementById('compare-bar');
          if (!bar) return;
          bar.hidden = ids.length === 0 || location.pathname === '/comparar';
          bar.querySelector('[data-compare-count]').textContent = String(ids.length);
          bar.querySelector('[data-compare-link]').href = `/comparar?ids=${ids.join(',')}`;
          bar.querySelector('[data-compare-link]').classList.toggle('pointer-events-none', ids.length < 2);
          bar.querySelector('[data-compare-link]').setAttribute('aria-disabled', String(ids.length < 2));
          bar.querySelector('[data-compare-hint]').hidden = ids.length >= 2;
        },
      };

      document.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-compare-toggle]');
        if (btn) {
          e.preventDefault();
          window.NoteStoreCompare.toggle(Number(btn.dataset.compareToggle));
          return;
        }
        if (e.target.closest('[data-compare-clear]')) window.NoteStoreCompare.save([]);
      });
    </script>

    <main id="contenido">
      <slot />
    </main>
    <Footer />

    <div
      id="compare-bar"
      hidden
      class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-surface/95 backdrop-blur-sm"
    >
      <div class="mx-auto flex max-w-7xl items-center gap-4 px-4 py-3 sm:px-6">
        <p class="text-sm">
          <span class="font-mono text-accent" data-compare-count>0</span>
          <span class="text-fg-muted">para comparar</span>
          <span class="hidden text-fg-subtle sm:inline" data-compare-hint>· elegí al menos 2</span>
        </p>
        <button type="button" data-compare-clear class="btn-ghost ml-auto cursor-pointer text-sm">Limpiar</button>
        <a href="/comparar" data-compare-link class="btn btn-primary aria-disabled:opacity-45">Comparar</a>
      </div>
    </div>

    <div
      id="toast"
      role="status"
      aria-live="polite"
      class="pointer-events-none fixed bottom-20 left-1/2 z-100 -translate-x-1/2 translate-y-20 border border-line-strong bg-surface-3 px-4 py-2.5 text-sm font-medium text-fg opacity-0 transition-all duration-200"
    >
    </div>

    <script is:inline>
      window.NoteStoreCompare.sync();
    </script>
  </body>
</html>
