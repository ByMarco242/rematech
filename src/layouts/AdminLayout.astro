---
import '../styles/global.css';
import { getDb } from '../lib/db';

interface Props {
  title?: string;
}

const { title = 'Panel admin — NoteStore' } = Astro.props;
const path = Astro.url.pathname;
const user = Astro.locals.user;

const allLinks = [
  {
    href: '/admin',
    label: 'Dashboard',
    icon: 'M3 13h8V3H3zM13 21h8V11h-8zM13 3v5h8V3zM3 21h8v-5H3z',
    exact: true,
    adminOnly: false,
  },
  {
    href: '/admin/pos',
    label: 'Venta',
    icon: 'M2 3h2l.4 2M7 13h10l4-8H5.4M7 13 5.4 5M7 13l-2.3 2.3c-.6.6-.2 1.7.7 1.7H17m0 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm-8 2a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z',
    exact: false,
    adminOnly: false,
  },
  {
    href: '/admin/pedidos',
    label: 'Pedidos',
    icon: 'M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4ZM3 6h18M16 10a4 4 0 0 1-8 0',
    exact: false,
    adminOnly: false,
  },
  {
    href: '/admin/productos',
    label: 'Productos',
    icon: 'm7.5 4.27 9 5.15M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Zm-18-.27 8.88 5.14a2 2 0 0 0 2 0L21 8M12 22V12',
    exact: false,
    adminOnly: false,
  },
  {
    href: '/admin/inventario',
    label: 'Inventario',
    icon: 'M12 22v-9M15.17 2.21a1.67 1.67 0 0 1 1.63 0L21 4.57a1.93 1.93 0 0 1 0 3.36L8.82 14.79a1.655 1.655 0 0 1-1.64 0L3 12.43a1.93 1.93 0 0 1 0-3.36zM20 13v3.87a2.06 2.06 0 0 1-1.11 1.83l-6 3.08a1.93 1.93 0 0 1-1.78 0l-6-3.08A2.06 2.06 0 0 1 4 16.87V13',
    exact: false,
    adminOnly: false,
  },
  {
    href: '/admin/metricas',
    label: 'Métricas',
    icon: 'M3 3v16a2 2 0 0 0 2 2h16M18 17V9M13 17V5M8 17v-3',
    exact: false,
    adminOnly: true,
  },
  {
    href: '/admin/finanzas',
    label: 'Finanzas',
    icon: 'M3 3v18h18M7 14l4-4 4 4 5-6',
    exact: false,
    adminOnly: true,
  },
  {
    href: '/admin/caja',
    label: 'Caja diaria',
    icon: 'M2 7h20v12H2zM2 11h20M6 15h2M16 3l-4 4-4-4',
    exact: false,
    adminOnly: false,
  },
  {
    href: '/admin/compras',
    label: 'Compras',
    icon: 'M3 3h18v4H3zM5 7v13h14V7M10 12h4',
    exact: false,
    adminOnly: true,
  },
  {
    href: '/admin/auditoria',
    label: 'Auditoría',
    icon: 'M9 12l2 2 4-4M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z',
    exact: false,
    adminOnly: true,
  },
  {
    href: '/admin/clientes',
    label: 'Clientes',
    icon: 'M18 21a8 8 0 0 0-16 0M10 13a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM22 20c0-3.37-2-6.5-4-8a5 5 0 0 0-.45-8.3',
    exact: false,
    adminOnly: true,
  },
  {
    href: '/admin/gastos',
    label: 'Gastos',
    icon: 'M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6',
    exact: false,
    adminOnly: true,
  },
  {
    href: '/admin/categorias',
    label: 'Categorías',
    icon: 'M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l7.71 7.71a2.41 2.41 0 0 0 3.408 0l7.3-7.3a2.41 2.41 0 0 0 0-3.41zM7.5 8v-.01',
    exact: false,
    adminOnly: true,
  },
  {
    href: '/admin/usuarios',
    label: 'Usuarios',
    icon: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75M9 3a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z',
    exact: false,
    adminOnly: true,
  },
  {
    href: '/admin/cupones',
    label: 'Cupones',
    icon: 'M9 12h6M9 16h6M14.5 3.5a2.121 2.121 0 0 1 3 3L7 17l-4 1 1-4Z',
    exact: false,
    adminOnly: true,
  },
  {
    href: '/admin/resenas',
    label: 'Reseñas',
    icon: 'M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21Z',
    exact: false,
    adminOnly: true,
  },
  {
    href: '/admin/envios',
    label: 'Envíos',
    icon: 'M3 3h13v10H3zM16 8h4l3 3v5h-7V8zM5.5 21a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5ZM18.5 21a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
    exact: false,
    adminOnly: true,
  },
  {
    href: '/admin/configuracion',
    label: 'Configuración',
    icon: 'M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2ZM12 15a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z',
    exact: false,
    adminOnly: true,
  },
];

const links = allLinks.filter((l) => !l.adminOnly || user?.is_admin);

function isActive(l: (typeof links)[number]) {
  return l.exact ? path === l.href : path.startsWith(l.href);
}

const groups = [
  { title: 'Operación', hrefs: ['/admin', '/admin/pos', '/admin/pedidos', '/admin/caja', '/admin/clientes'] },
  { title: 'Catálogo', hrefs: ['/admin/productos', '/admin/inventario', '/admin/compras', '/admin/categorias', '/admin/resenas'] },
  { title: 'Finanzas', hrefs: ['/admin/finanzas', '/admin/metricas', '/admin/gastos', '/admin/cupones'] },
  { title: 'Ajustes', hrefs: ['/admin/envios', '/admin/usuarios', '/admin/auditoria', '/admin/configuracion'] },
]
  .map((g) => ({ title: g.title, links: links.filter((l) => g.hrefs.includes(l.href)) }))
  .filter((g) => g.links.length > 0);

// Contador de pedidos por confirmar junto a "Pedidos"
const db = await getDb();
const pendingRes = await db.execute("SELECT COUNT(*) AS n FROM orders WHERE status = 'pendiente'");
const badges: Record<string, number> = { '/admin/pedidos': Number(pendingRes.rows[0].n) };
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='%23171717'/><rect x='8' y='8' width='16' height='16' fill='%23ff4d00'/></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..800&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-neutral-100 text-neutral-900 antialiased">
    <div class="flex min-h-screen">
      <aside id="admin-nav" class="fixed inset-y-0 left-0 z-50 flex w-60 flex-col bg-neutral-950 text-neutral-300 max-lg:hidden max-lg:data-open:flex">
        <div class="flex items-center justify-between px-5 py-5">
          <a href="/admin" class="flex items-center gap-2 font-bold text-white">
            <span class="size-3 bg-[#ff4d00]" aria-hidden="true"></span>
            <span>NoteStore <span class="text-xs font-medium text-neutral-500">admin</span></span>
          </a>
          <button type="button" class="cursor-pointer p-1 text-neutral-400 hover:text-white lg:hidden" aria-label="Cerrar menú" data-admin-nav-close>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-5" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
          </button>
        </div>

        <nav class="flex-1 space-y-5 overflow-y-auto px-3 pb-4" aria-label="Panel">
          {groups.map((g) => (
            <div>
              <p class="px-3 pb-1.5 text-[11px] font-semibold tracking-wider text-neutral-500 uppercase">{g.title}</p>
              <ul class="space-y-0.5">
                {g.links.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      aria-current={isActive(l) ? 'page' : undefined}
                      class:list={[
                        'flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors',
                        isActive(l) ? 'bg-white/10 text-white' : 'hover:bg-neutral-800/60 hover:text-white',
                      ]}
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0" aria-hidden="true">
                        <path d={l.icon} />
                      </svg>
                      <span class="flex-1">{l.label}</span>
                      {badges[l.href] > 0 && (
                        <span class="rounded bg-[#ff4d00] px-1.5 text-[11px] leading-5 font-semibold text-neutral-950" aria-label={`${badges[l.href]} por confirmar`}>
                          {badges[l.href]}
                        </span>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>

        <div class="border-t border-neutral-800 p-4">
          <p class="truncate px-1 text-xs text-neutral-500">{user?.email}</p>
          <div class="mt-3 flex gap-2">
            <a href="/" class="flex-1 rounded-lg border border-neutral-700 px-3 py-2 text-center text-xs font-semibold transition-colors hover:bg-neutral-800">
              Ver tienda
            </a>
            <form method="POST" action="/api/logout" class="flex-1">
              <button type="submit" class="w-full cursor-pointer rounded-lg bg-neutral-800 px-3 py-2 text-xs font-semibold transition-colors hover:bg-neutral-700">
                Salir
              </button>
            </form>
          </div>
        </div>
      </aside>
      <div class="fixed inset-0 z-40 hidden bg-black/50 lg:hidden" data-admin-nav-backdrop></div>

      <div class="min-w-0 flex-1 lg:pl-60">
        <header class="sticky top-0 z-30 flex h-14 items-center gap-3 border-b border-neutral-200 bg-white px-4 lg:hidden">
          <button type="button" class="cursor-pointer p-1 text-neutral-600" aria-label="Abrir menú" aria-controls="admin-nav" aria-expanded="false" data-admin-nav-open>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-5" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </button>
          <a href="/admin" class="font-bold">NoteStore <span class="text-xs text-neutral-400">admin</span></a>
          <span class="ml-auto truncate text-sm text-neutral-500">{links.find(isActive)?.label}</span>
        </header>

        <main class="mx-auto max-w-6xl p-4 sm:p-8">
          <slot />
        </main>
      </div>
    </div>

    <script is:inline>
      (() => {
        const nav = document.getElementById('admin-nav');
        const backdrop = document.querySelector('[data-admin-nav-backdrop]');
        const opener = document.querySelector('[data-admin-nav-open]');
        const set = (open) => {
          nav.toggleAttribute('data-open', open);
          backdrop.classList.toggle('hidden', !open);
          opener.setAttribute('aria-expanded', String(open));
          if (open) nav.querySelector('a')?.focus();
        };
        opener.addEventListener('click', () => set(true));
        backdrop.addEventListener('click', () => set(false));
        document.querySelector('[data-admin-nav-close]').addEventListener('click', () => set(false));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && nav.hasAttribute('data-open')) set(false);
        });
      })();
    </script>
  </body>
</html>
